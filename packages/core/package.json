{
  "name": "@ariane-ui/core",
  "version": "0.1.0-alpha.8",
  "type": "module",
  "description": "Accessible web components library",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./cdn": "./cdn/index.js",
    "./cdn.prod": "./cdn/index.prod.js",
    "./cdn/autoloader": "./cdn/autoloader.js",
    "./cdn/autoloader.prod": "./cdn/autoloader.prod.js",
    "./themes/*.css": "./dist/styles/themes/*.css",
    "./themes/*.js": "./dist/styles/themes/*.js",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cdn"
  ],
  "scripts": {
    "build": "npm run build:manifest && npm run build:bundles && npm run build:css && npm run build:types",
    "build:dev": "npm run build:manifest && npm run build:bundles:dev && npm run build:css && npm run build:types",
    "build:manifest": "cem analyze --config cem.config.js",
    "build:bundles": "node scripts/build-bundles.js",
    "build:bundles:dev": "node scripts/build-bundles.js --dev",
    "build:bundles:prod": "node scripts/build-bundles.js --prod",
    "build:css": "node scripts/build-css.js",
    "build:types": "tsc --emitDeclarationOnly --declarationMap",
    "dev": "node scripts/build-bundles.js --watch & node scripts/build-css.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "web-test-runner",
    "test:browser:watch": "web-test-runner --watch",
    "lint": "eslint src",
    "create": "node scripts/create-component.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@lit/context": "^1.1.6",
    "@shoelace-style/localize": "^3.2.3",
    "lit": "^3.2.1",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^4.0.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "custom-element-vs-code-integration": "^1.5.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.8.9",
    "minify-literals": "^2.1.0",
    "sinon": "^22.0.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jogo-labs/ariane"
  },
  "customElements": "dist/custom-elements.json",
  "config": {
    "componentPrefix": "ar"
  }
}
