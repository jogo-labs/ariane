---
/**
 * Playground.astro
 *
 * Affiche les variantes d'un composant empilées verticalement (style Webawesome),
 * un playground interactif avec contrôles générés depuis le CEM,
 * et la référence API complète via ComponentApi.
 *
 * Tout le rendu des composants est server-side (Fragment set:html).
 * La coloration syntaxique est assurée par highlight.js (client-side, uniforme).
 * Le JS client gère la copie du code, les contrôles du playground et le toggle preview.
 */

import ComponentApi from './ComponentApi.astro';
import { type CemDeclaration, type CemControl } from '../utils/cem-types.ts';

interface Variant {
    name:         string;
    label?:       string;
    description?: string;
    html:         string;
}

interface RelatedTokens {
    component:   string;
    description: string;
}

interface Props {
    variants:       Variant[];
    tagName:        string;
    displayMode:    'demo' | 'docs';
    parentTag?:     string;
    playgroundHtml: string;
    controls:       CemControl[];
    component:      CemDeclaration;
    relatedTokens?: RelatedTokens[];
}

const {
    variants,
    tagName,
    displayMode = 'demo',
    parentTag,
    playgroundHtml,
    controls,
    component,
    relatedTokens = [],
} = Astro.props;

const showPlayground = displayMode === 'demo';
---

{/* ── Exemples (variantes) ── */}
{variants.length > 0 && (
    <section id="exemples">
        <h3 class="section-title">Exemples</h3>
        {/* ── Encart thème de démo ── */}
        {/* Ariane est headless : aucun style n'est intégré au composant. Les previews
            ci-dessous chargent le thème de démo `default.css` fourni avec la librairie —
            à ne pas confondre avec un style par défaut intrinsèque au composant. */}
        <ar-alert variant="info" style="margin-bottom: 1rem">
            <p style="margin: 0">Les exemples ci-dessous sont affichés avec le thème de démo <code>default.css</code> fourni par Ariane.<br>
            Un composant headless n'a aucun style intégré — remplacez ce thème par le vôtre pour un rendu différent.</p>
        </ar-alert>
        <div class="main-section">
            {variants.map((variant) => (
                <section id={`exemple-${variant.name}`}>
                    <h4 class="subsection-title">{variant.label ?? variant.name}</h4>
                    {variant.description && (
                        <p class="variant-description">{variant.description}</p>
                    )}
                    <div>
                        <div class="preview-wrap">
                            <div class="preview">
                                <Fragment set:html={variant.html} />
                            </div>
                        </div>
                        <ar-collapse class="code-collapse" for={`collapse-${variant.name}`}>
                            <div class="code-block">
                                <button class="copy-btn" data-copy aria-label="Copier le code">Copier</button>
                                <pre><code class="language-html">{variant.html.trim()}</code></pre>
                            </div>
                        </ar-collapse>
                        <div class="preview-controls">
                            <button class="code-collapse-btn" id={`collapse-${variant.name}`}>
                                <span class="sr-only">Voir le&nbsp;</span>Code&nbsp;
                                <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                            </button>
                        </div>
                    </div>
                </section>
            ))}
        </div>
    </section>
)}

{/* ── Encart parent pour les sous-composants ── */}
{parentTag && (
    <div class="parent-notice">
        {/* <span class="parent-notice-icon">&#8593;</span> */}
        Ce composant est un sous-composant de
        <a href={`/components/${parentTag.replace(/^ar-/, '')}`}>
            <code>&lt;{parentTag}&gt;</code>
        </a>
    </div>
)}

{/* ── Playground interactif ── */}
{showPlayground && (
    <section class="playground-section" id="playground" data-playground data-tag-name={tagName}>
        <div class="playground-label" aria-hidden="true"><span class="playground-dot">●</span> PLAYGROUND</div>
        <div class="playground-card">
            <div class="preview-wrap">
                <div class="preview" data-playground-preview>
                    <Fragment set:html={playgroundHtml} />
                </div>
            </div>
            <div class="playground-code-block">
                <button class="copy-btn" data-copy-playground aria-label="Copier le code">Copier</button>
                {/* Le <pre><code> est mis à jour par playground.js après chaque changement de contrôle */}
                <pre data-playground-pre><code class="language-html" data-playground-code>{playgroundHtml.trim()}</code></pre>
            </div>
            {controls.length > 0 && (
                <div class="controls-panel">
                    {controls.map((ctrl) => (
                        <label class="control-row">
                            <span class="control-label">{ctrl.attribute}</span>
                            {ctrl.controlType === 'select' && (
                                <select
                                    data-attr={ctrl.attribute}
                                    data-playground-ctrl
                                    data-default={ctrl.default ?? ''}
                                >
                                    {ctrl.addDefault && (
                                        <option value="" selected={!ctrl.default}>Par défaut</option>
                                    )}
                                    {ctrl.options.map((opt) => (
                                        <option value={opt} selected={opt === ctrl.default}>{opt}</option>
                                    ))}
                                </select>
                            )}
                            {ctrl.controlType === 'checkbox' && (
                                <input
                                    type="checkbox"
                                    data-attr={ctrl.attribute}
                                    data-playground-ctrl
                                    checked={ctrl.default === 'true'}
                                />
                            )}
                            {ctrl.controlType === 'text' && (
                                <input
                                    type="text"
                                    data-attr={ctrl.attribute}
                                    data-playground-ctrl
                                    data-default={ctrl.default ?? ''}
                                    placeholder={ctrl.default ?? ''}
                                    value={ctrl.default ?? ''}
                                />
                            )}
                            {ctrl.controlType === 'number' && (
                                <input
                                    type="number"
                                    data-attr={ctrl.attribute}
                                    data-playground-ctrl
                                    data-default={ctrl.default ?? ''}
                                    placeholder={ctrl.default ?? ''}
                                    value={ctrl.default ?? ''}
                                />
                            )}
                        </label>
                    ))}
                </div>
            )}
        </div>
    </section>
)}

{/* ── Référence API ── */}
<section id="reference-api">
    <h3 class="section-title">Référence API</h3>
    <ComponentApi component={component} relatedTokens={relatedTokens} />
</section>

<style>
    @import '../styles/doc-prose.css';

    /* Le cas général (masquer tout élément custom non défini) est couvert par la règle
       globale `*:not(:defined)` dans Layout.astro (site-wide : nav du header, démos
       injectées via `set:html` non scopées par Astro comprises). Reste ici uniquement le
       correctif supplémentaire propre au ar-collapse du bloc de code : un élément custom
       non défini a un display UA par défaut de "inline", donc `height` n'a aucun effet sur
       lui — visibility:hidden masque bien la peinture, mais le `.code-block` (block-level)
       qu'il contient continue de réserver son espace de layout (mesuré : ~160px). Résultat
       sans ce correctif : un espace vide invisible qui s'effondre brutalement à 0 dès la
       définition du composant (le panel est fermé par défaut) — un décalage de mise en page
       perceptible comme un flash, même si rien n'est réellement peint. display:block +
       height:0 + overflow:hidden alignent l'état "non défini" sur l'état final réel (panel
       fermé), donc plus aucun saut. Ce sélecteur cible spécifiquement le wrapper de bloc de
       code (class="code-collapse") — jamais les démos ar-collapse de sa propre page de doc
       (couvertes par la règle générale ci-dessus), qui n'ont pas vocation à être forcées à
       hauteur 0 (ex. variante "open"). */
    ar-collapse.code-collapse:not(:defined) {
        visibility: hidden;
        display: block;
        height: 0;
        overflow: hidden;
    }

    /* ── Variantes ─────────────────────────────────────── */

    .examples-section {
        display:        flex;
        flex-direction: column;
        gap:            2.5rem;
    }

    .playground-section {
        display:        flex;
        flex-direction: column;
        gap:            1rem;
    }

    .playground-card {
        display:        flex;
        flex-direction: column;
        border:         1px solid #d4bbff;
        border-radius:  10px;
        overflow:       hidden;
        box-shadow:     0 0 0 3px rgba(124,58,237,0.06);
    }

    .playground-label {
        font-size:      0.8rem;
        font-weight:    600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color:          var(--doc-accent);
        margin-bottom:  0.5rem;
        display:        flex;
        align-items:    center;
        gap:            0.35rem;
    }

    .playground-dot {
        font-size: 0.5rem;
    }

    h5 {
        font-size:   1rem;
        font-weight: 600;
        color:       var(--doc-text);
        margin:      0;
    }

    .variant-description {
        margin: .75rem 0 1rem;
        font-size: .9rem;
    }

    /* ── Preview ─────────────────────────────────────── */

    .preview-wrap {
        position: relative;
    }

    .preview-theme-toggle {
        position:        absolute;
        top:             0.5rem;
        right:           0.5rem;
        z-index:         10;
        display:         flex;
        align-items:     center;
        justify-content: center;
        width:           1.75rem;
        height:          1.75rem;
        background:      color-mix(in srgb, var(--doc-bg) 75%, transparent);
        backdrop-filter: blur(4px);
        border:          1px solid var(--doc-border);
        border-radius:   0.375rem;
        cursor:          pointer;
        color:           var(--doc-text-muted);
        transition:      background 0.15s;
    }

    .preview-theme-toggle:hover {
        background: var(--doc-bg);
    }

    .preview {
        display:       flex;
        flex-wrap:     wrap;
        gap:           0.75rem;
        align-items:   center;
        padding:       2rem;
        border:        1px solid var(--doc-border);
        border-bottom: 0;
        border-radius: 0.5rem 0.5rem 0 0;
        background: var(--doc-bg);
    }

    /* ── Code block ─────────────────────────────────── */

    .code-block,
    .playground-code-block {
        position:   relative;
        border:     1px solid var(--doc-border);
        border-top: none;
        overflow:   hidden;
    }

    .preview-controls {
        display: flex;
    }


    .code-collapse-btn {
        display:         inline-flex;
        flex:            1 1 100%;
        align-items:     center;
        justify-content: center;
        gap:             0.4rem;
        background:      transparent;
        color:           var(--doc-text);
        font-family:     inherit;
        font-size:       0.9rem;
        font-weight:     600;
        padding:         0.65rem 1.5rem;
        text-decoration: none;
        border:          1.5px solid var(--doc-border);
        cursor:          pointer;
        transition:      border-color 0.15s, color 0.15s;
        width: 100%;

        &:hover {
            border-color: var(--doc-accent);
            color:        var(--doc-accent);
        }

        svg {
            height: 1.25rem;
            width: auto;
            transform: rotate(0deg);
        }

        &[aria-expanded="true"] svg {
            rotate: 180deg;
        }
    }

    .preview-controls,
    .code-collapse-btn {
        border-end-end-radius: .5rem;
        border-end-start-radius: .5rem;
    }
    .copy-btn {
        position:      absolute;
        top:           0.5rem;
        right:         0.5rem;
        padding:       0.25rem 0.6rem;
        background:    rgba(255,255,255,0.08);
        color:         #adb5bd;
        border:        1px solid rgba(255,255,255,0.15);
        border-radius: 0.25rem;
        font-size:     0.75rem;
        cursor:        pointer;
        transition:    background 0.15s, color 0.15s;
        z-index:       1;
    }

    .copy-btn:hover  { background: rgba(255,255,255,0.15); color: #e6edf3; }
    .copy-btn.copied { background: var(--ar-color-success-text, #0a8560); color: #fff; border-color: transparent; }

    /* highlight.js gère le background via son thème CSS — on aligne juste la typo */
    :global(.code-block pre),
    :global(.playground-code-block pre) {
        margin:      0;
        padding:     1rem 1.25rem;
        overflow-x:  auto;
        font-family: 'Fira Code', 'Cascadia Code', monospace;
        font-size:   0.8rem;
        line-height: 1.6;
        background:  var(--doc-code-block-bg);
    }

    :global(.code-block pre code),
    :global(.playground-code-block pre code) {
        font-family: inherit;
        font-size:   inherit;
        padding:     0;
        background:  transparent;
        color:       #cdd6f4;
    }

    :global(.code-block pre),
    :global(.playground-code-block pre) {
        border-radius: 0;
    }

    /* ── Playground contrôles ────────────────────────── */

    .playground-section .preview-wrap { margin-bottom: 0; }
    .playground-section .preview {
        border:        none;
        border-bottom: 1px solid var(--doc-border);
        border-bottom: 0;
        border-radius: 0;
    }

    .playground-section .playground-code-block {
        border:        none;
        border-bottom: 1px solid var(--doc-border);
        border-bottom: 0;
    }

    .playground-section .controls-panel {
        border:     none;
        border-top: none;
    }

    .controls-panel {
        border:        1px solid var(--doc-border);
        border-top:    none;
        border-radius: 0 0 0.5rem 0.5rem;
        padding:       1rem 1.5rem;
        background:    var(--doc-nav-bg);
        display:       flex;
        flex-wrap:     wrap;
        gap:           1rem 2rem;
        align-items:   start;
    }

    .control-row {
        display:        flex;
        flex-direction: column;
        gap:            0.25rem;
        min-width:      140px;
    }

    .control-label {
        font-size:   0.75rem;
        font-weight: 600;
        color:       var(--doc-text-muted);
        font-family: 'Fira Code', 'Cascadia Code', monospace;
    }

    .control-row select,
    .control-row input[type="text"],
    .control-row input[type="number"] {
        padding:       0.3rem 0.5rem;
        border:        1px solid var(--doc-accent-border);
        border-radius: 0.25rem;
        font-size:     0.875rem;
        background:    var(--doc-bg);
        color:         var(--doc-text);
        width:         100%;
    }

    .control-row input[type="checkbox"] {
        width:      1.1rem;
        height:     1.1rem;
        cursor:     pointer;
        margin-top: 0.2rem;
    }

    /* ── Encart parent ───────────────────────────────── */

    .parent-notice {
        display:       flex;
        align-items:   center;
        gap:           0.5rem;
        padding:       0.75rem 1rem;
        background:    color-mix(in srgb, var(--ar-color-interactive, #2563eb) 8%, transparent);
        border:        1px solid color-mix(in srgb, var(--ar-color-interactive, #2563eb) 20%, transparent);
        border-radius: 0.5rem;
        font-size:     0.875rem;
        color:         var(--doc-text);
        margin:        1rem 0;
    }

    .parent-notice-icon {
        font-size:   1.1rem;
        font-weight: 700;
        color:       var(--ar-color-interactive, #2563eb);
    }

    .parent-notice a {
        color:           var(--ar-color-interactive, #2563eb);
        text-decoration: none;
        font-weight:     600;
    }

    .parent-notice a:hover { text-decoration: underline; }

    /* ── Boutons dans la preview (trigger + slotted)
     * :global() nécessaire : les boutons sont injectés via set:html et n'ont pas
     * l'attribut de portée Astro — la règle .preview.astro-xxx .btn.astro-xxx ne les atteint pas.
     * ─────────────────────────────────────────────────────────────────────── */

    .preview :global(.btn) {
        display:         inline-flex;
        align-items:     center;
        justify-content: center;
        padding:         0 var(--ar-button-padding-x, 1rem);
        min-height:      var(--ar-button-height, 2.5rem);
        border-radius:   var(--ar-button-border-radius, 0.375rem);
        border:          1px solid transparent;
        font-size:       var(--ar-font-size-md, 1rem);
        font-weight:     var(--ar-button-font-weight, 500);
        line-height:     1;
        cursor:          pointer;
        text-decoration: none;
        font-family:     inherit;
    }

    .preview :global(.btn-primary) {
        background:   var(--ar-button-bg, var(--ar-color-interactive, #283276));
        color:        var(--ar-button-color, #fff);
        border-color: var(--ar-button-border-color, var(--ar-color-interactive, #283276));
    }
    .preview :global(.btn-primary:hover) {
        background:   var(--ar-button-bg-hover, var(--ar-color-interactive-hover, #1b2256));
        border-color: var(--ar-button-bg-hover, var(--ar-color-interactive-hover, #1b2256));
    }

    .preview :global(.btn-secondary) {
        background:   var(--ar-button-secondary-bg, #fff);
        color:        var(--ar-color-text, #2e2e31);
        border-color: var(--ar-color-border, #e5e7eb);
    }
    .preview :global(.btn-secondary:hover) {
        background: var(--ar-color-bg-subtle, #f5f5f8);
    }

    .preview :global(.btn-danger) {
        background: var(--ar-button-danger-bg, #d04442);
        color: #fff;
    }
    .preview :global(.btn-danger:hover) {
        background: var(--ar-color-danger-40, #a52c2b);
        color: #fff;
    }

    /* ── Styles consumer pour les items de menu dans les démos dropdown
     * Ces styles vivent ici (couche docs) car ar-dropdown-item est intentionnellement
     * unstyled — c'est le consumer qui apporte le CSS de ses boutons/liens.
     * Le sélecteur évite d'ajouter une classe dans le snippet de code.
     * ─────────────────────────────────────────────────────────────────────────────── */

    .preview :global(ar-dropdown-item button),
    .preview :global(ar-dropdown-item a) {
        display:       block;
        width:         100%;
        padding:       0.4rem 0.75rem;
        background:    transparent;
        border:        none;
        border-radius: 0.25rem;
        text-align:    left;
        font-size:     0.875rem;
        font-family:   inherit;
        color:         var(--ar-color-text, #2e2e31);
        cursor:        pointer;
        white-space:   nowrap;
    }

    .preview :global(ar-dropdown-item button:hover),
    .preview :global(ar-dropdown-item a:hover) {
        background: var(--ar-color-bg-subtle, #f5f5f8);
    }

    .preview :global(ar-dropdown hr) {
        border:     none;
        border-top: 1px solid var(--ar-color-border, #e5e7eb);
        margin:     0.25rem 0;
    }

    /*
     * .preview est un flex container : sur l'axe principal (horizontal), les enfants se
     * dimensionnent selon leur contenu par défaut, pas selon la largeur disponible. Un
     * composant `display: block` qui mesure sa propre largeur pour adapter son rendu
     * (ar-pagination, ResizeObserver) se retrouve donc contraint à la largeur de son
     * contenu au lieu de la largeur réelle du preview.
     */
    .preview > :global(ar-pagination) {
        flex: 1 1 100%;
    }
</style>
