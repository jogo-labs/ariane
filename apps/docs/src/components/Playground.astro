---
/**
 * Playground.astro
 *
 * Affiche les variantes d'un composant empilées verticalement (style Webawesome),
 * un playground interactif avec contrôles générés depuis le CEM,
 * et la référence API complète via ComponentApi.
 *
 * Tout le rendu des composants est server-side (Fragment set:html).
 * La coloration syntaxique est assurée par highlight.js (client-side, uniforme).
 * Le JS client gère la copie du code et les contrôles du playground.
 */

import ComponentApi from './ComponentApi.astro';
import CodeBlock from './CodeBlock.astro';
import { type CemDeclaration, type CemControl } from '../utils/cem-types.ts';

interface Variant {
    name:         string;
    label?:       string;
    description?: string;
    html:         string;
}

interface RelatedTokens {
    component:   string;
    description: string;
}

interface Props {
    variants:       Variant[];
    tagName:        string;
    displayMode:    'demo' | 'docs';
    parentTag?:     string;
    playgroundHtml: string;
    controls:       CemControl[];
    component:      CemDeclaration;
    relatedTokens?: RelatedTokens[];
}

const {
    variants,
    tagName,
    displayMode = 'demo',
    parentTag,
    playgroundHtml,
    controls,
    component,
    relatedTokens = [],
} = Astro.props;

const showPlayground = displayMode === 'demo';
---

{/* ── Exemples (variantes) ── */}
{variants.length > 0 && (
    <section id="exemples">
        <h3 class="section-title">Exemples</h3>
        <ar-alert variant="info" without-notification class="doc-callout-alert" style="margin-bottom: 1.5rem">
            <p style="margin: 0">Les exemples de cette page sont affichés avec le thème de démo <code>default.css</code> fourni par Ariane.</p>
        </ar-alert>
        <div class="main-section examples-section">
            {variants.map((variant) => (
                <article id={`exemple-${variant.name}`} class="example">
                    <div class="example-head">
                        <h4 class="subsection-title">{variant.label ?? variant.name}</h4>
                        {variant.description && (
                            <p class="variant-description">{variant.description}</p>
                        )}
                    </div>
                    <div class="playground-card">
                        <div class="preview-wrap">
                            <div class="preview">
                                <Fragment set:html={variant.html} />
                            </div>
                        </div>
                        <details class="preview-controls-wrap">
                            <summary class="controls-panel controls-panel--collapse">
                                <span class="chevron" aria-hidden="true">›</span>
                                <span>Voir le code</span>
                            </summary>
                            <CodeBlock code={variant.html.trim()} />
                        </details>
                    </div>
                </article>
            ))}
        </div>
    </section>
)}

{/* ── Playground interactif ── */}
{showPlayground && (
    <section class="playground-section" id="playground" data-playground data-tag-name={tagName}>
        <h3 class="section-title">Démo interactive</h3>
            <p class="variant-description">Manipulez les attributs pour voir le code et la preview se mettre à jour.</p>
        <div class="playground-card">
            <div class="preview-wrap">
                <div class="preview" data-playground-preview>
                    <Fragment set:html={playgroundHtml} />
                </div>
            </div>
            <div class="preview-controls-wrap">
                {controls.length > 0 && (
                    <div class="controls-panel controls-panel--interactive">
                        {controls.map((ctrl) => (
                            <label class="control-row">
                                <span class="control-label">{ctrl.attribute}</span>
                                {ctrl.controlType === 'select' && (
                                    <select
                                        data-attr={ctrl.attribute}
                                        data-playground-ctrl
                                        data-default={ctrl.default ?? ''}
                                    >
                                        {ctrl.addDefault && (
                                            <option value="" selected={!ctrl.default}>Par défaut</option>
                                        )}
                                        {ctrl.options.map((opt) => (
                                            <option value={opt} selected={opt === ctrl.default}>{opt}</option>
                                        ))}
                                    </select>
                                )}
                                {ctrl.controlType === 'checkbox' && (
                                    <input
                                        type="checkbox"
                                        data-attr={ctrl.attribute}
                                        data-playground-ctrl
                                        checked={ctrl.default === 'true'}
                                    />
                                )}
                                {ctrl.controlType === 'text' && (
                                    <input
                                        type="text"
                                        data-attr={ctrl.attribute}
                                        data-playground-ctrl
                                        data-default={ctrl.default ?? ''}
                                        placeholder={ctrl.default ?? ''}
                                        value={ctrl.default ?? ''}
                                    />
                                )}
                                {ctrl.controlType === 'number' && (
                                    <input
                                        type="number"
                                        data-attr={ctrl.attribute}
                                        data-playground-ctrl
                                        data-default={ctrl.default ?? ''}
                                        placeholder={ctrl.default ?? ''}
                                        value={ctrl.default ?? ''}
                                    />
                                )}
                            </label>
                        ))}
                    </div>
                )}
                {/* Le contenu est mis à jour par playground.js après chaque changement de contrôle */}
                <CodeBlock code={playgroundHtml.trim()} interactive />
            </div>
        </div>
    </section>
)}

{/* ── Référence API ── */}
<section id="reference-api">
    <h3 class="section-title">API</h3>
    <ComponentApi component={component} relatedTokens={relatedTokens} />
</section>

<style>
    @import '../styles/doc-prose.css';

    /* Le cas général (masquer tout élément custom non défini) est couvert par la règle
       globale `*:not(:defined)` dans Layout.astro (site-wide : nav du header, démos
       injectées via `set:html` non scopées par Astro comprises). Reste ici uniquement le
       correctif supplémentaire propre au ar-collapse du bloc de code : un élément custom
       non défini a un display UA par défaut de "inline", donc `height` n'a aucun effet sur
       lui — visibility:hidden masque bien la peinture, mais le `.code-block` (block-level)
       qu'il contient continue de réserver son espace de layout (mesuré : ~160px). Résultat
       sans ce correctif : un espace vide invisible qui s'effondre brutalement à 0 dès la
       définition du composant (le panel est fermé par défaut) — un décalage de mise en page
       perceptible comme un flash, même si rien n'est réellement peint. display:block +
       height:0 + overflow:hidden alignent l'état "non défini" sur l'état final réel (panel
       fermé), donc plus aucun saut. Ce sélecteur cible spécifiquement le wrapper de bloc de
       code (class="code-collapse") — jamais les démos ar-collapse de sa propre page de doc
       (couvertes par la règle générale ci-dessus), qui n'ont pas vocation à être forcées à
       hauteur 0 (ex. variante "open"). */

    /* ── Variantes ─────────────────────────────────────── */

    .examples-section {
        display:        flex;
        flex-direction: column;
        gap:            2.5rem;

        .example {
            display:        flex;
            flex-direction: column;
            gap: 1rem;
        }
    }

    .playground-section {
        display:        flex;
        flex-direction: column;
        gap:            1rem;
    }

    .playground-card {
        display:        flex;
        flex-direction: column;
        border-radius: .5rem;
        border: 1px solid var(--doc-border);
        overflow: hidden;
    }

    .playground-label {
        font-size:      0.8rem;
        font-weight:    var(--doc-font-weight-semibold);
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color:          var(--doc-accent);
        margin-bottom:  0.5rem;
        display:        flex;
        align-items:    center;
        gap:            0.35rem;
    }

    h5 {
        font-size:   1rem;
        font-weight: var(--doc-font-weight-semibold);
        color:       var(--doc-text);
        margin:      0;
    }

    .variant-description {
        color: var(--doc-text-muted);
        margin: 0;
        font-size: var(--doc-font-size-sm);
    }

    /* ── Preview ─────────────────────────────────────── */

    .preview-wrap {
        position: relative;
    }

    .preview {
        display:       flex;
        flex-wrap:     wrap;
        gap:           0.75rem;
        align-items:   center;
        padding:       2rem;
        border-bottom: 0;
        border-radius: 0.5rem 0.5rem 0 0;
        /* Fond pointillé — reprend les points du rail (spec §6, différé au
           sous-chantier 3, cf. docs/superpowers/specs/2026-09-10-doc-layout-redesign-110-design.md). */
        background-color: var(--doc-bg);
        background-image: radial-gradient(circle at 1px 1px, var(--doc-rail) 1px, transparent 0);
        background-size: 16px 16px;
    }

    /* ── Code block ─────────────────────────────────── */
    /* Forme/typo du bouton Copier et du bloc de code : partagées via
       doc-code-block.css (CodeBlock.astro). Seule la bordure propre à ce
       contexte reste ici (séparateur du panneau contrôles au-dessus —
       pas une boîte autonome comme sur la home). :global() car
       .code-block est rendu par le composant enfant CodeBlock, hors du
       scope Astro de ce fichier. */
    :global(.code-block) {
        border-top: 1px solid var(--doc-border);
    }

    /* ── Playground contrôles ────────────────────────── */

    .preview-controls-wrap {
        background:    var(--doc-surface);
        border-top: 1px solid var(--doc-border);
    }

    .controls-panel {
        display: flex;
        padding: 0.95rem 1.15rem;
        align-items:   start;
    }

    .controls-panel--collapse {
        padding-block-start: 0.65rem;
        padding-block-end: 0.65rem;
        gap:             0.4rem;
        color:           var(--doc-text-muted);
        font-size:       var(--doc-font-size-sm);
        cursor:          pointer;
        transition:      color 0.15s;
        width: 100%;

        &:hover {
            color: var(--doc-text);
        }

        .chevron {
            font-family: var(--doc-font-mono);
            transition: transform 0.22s var(--doc-ease);
            display: inline-block;
        }
    }

    details.preview-controls-wrap[open] .chevron {
        transform: rotate(90deg);
    }

    .controls-panel--interactive {
        flex-wrap:     wrap;
        gap:           1rem 2rem;
    }

    .control-row {
        display:        flex;
        flex-direction: column;
        gap:            0.25rem;
        min-width:      140px;
        cursor: pointer;
    }

    .control-label {
        font-size:   var(--doc-font-size-xs);
        font-weight: var(--doc-font-weight-semibold);
        color:       var(--doc-text-muted);
        font-family: var(--doc-font-mono);
    }

    .control-row select,
    .control-row input[type="text"],
    .control-row input[type="number"] {
        padding:       0.3rem 0.5rem;
        border:        1px solid var(--doc-accent-border);
        border-radius: var(--doc-radius-sm);
        font-size:     0.875rem;
        background:    var(--doc-bg);
        color:         var(--doc-text);
        width:         100%;
    }

    .control-row input[type="checkbox"] {
        width:      1.1rem;
        height:     1.1rem;
        cursor:     pointer;
        margin-top: 0.2rem;
    }

    /* Les boutons .ar-btn/.ar-btn-* de la preview (trigger + slotted) sont
       stylisés globalement par presets/buttons.css (#200) — plus besoin de
       les redéfinir ici. */

    /* Les boutons/liens slottés dans ar-dropdown-item sont désormais stylisés
       (reset + hover + focus-visible) directement par default.css (#199) —
       plus rien à redéfinir ici. */

    .preview :global(ar-dropdown hr) {
        border:     none;
        margin:     0.25rem 0;
    }

    /*
     * .preview est un flex container : sur l'axe principal (horizontal), les enfants se
     * dimensionnent selon leur contenu par défaut, pas selon la largeur disponible. Un
     * composant `display: block` qui mesure sa propre largeur pour adapter son rendu
     * (ar-pagination, ResizeObserver) se retrouve donc contraint à la largeur de son
     * contenu au lieu de la largeur réelle du preview.
     */
    .preview > :global(ar-pagination) {
        flex: 1 1 100%;
    }
</style>
