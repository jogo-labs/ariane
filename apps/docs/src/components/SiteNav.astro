---
/**
 * SiteNav.astro
 *
 * Navigation principale du Design System.
 * Structure en sections : Foundations, Components.
 * Les composants sont auto-générés depuis le CEM + MDX.
 */
import { getCollection } from 'astro:content';
import { getSlug } from '../utils/tag-name.ts';
import manifest from '@cem';
import { type CemDeclaration, getCustomElements } from '../utils/cem-types.ts';

interface Props {
    currentPath?: string;
}

const { currentPath = '' } = Astro.props;

// ─── Sections statiques ──────────────────────────────────────────────────────

interface NavLink {
    href:        string;
    label:       string;
    ariaCurrent: 'page' | undefined;
}

function withCurrent(links: Omit<NavLink, 'ariaCurrent'>[]): NavLink[] {
    return links.map((link) => ({
        ...link,
        ariaCurrent: currentPath === link.href ? ('page' as const) : undefined,
    }));
}

const gettingStartedLinks: NavLink[] = withCurrent([
    { href: '/getting-started/quickstart', label: 'Démarrage rapide' },
    { href: '/getting-started/utilisation', label: 'Utilisation' },
    { href: '/getting-started/frameworks', label: 'Frameworks' },
]);

const themingLinks: NavLink[] = withCurrent([
    { href: '/theming/overview', label: 'Vue d\'ensemble' },
    { href: '/theming/appliquer-un-theme', label: 'Appliquer un thème' },
    { href: '/theming/personnalisation-avancee', label: 'Personnalisation avancée' },
    { href: '/theming/shadow-dom', label: 'Dans un shadow DOM applicatif' },
]);

const advancedUsageLinks: NavLink[] = withCurrent([
    { href: '/getting-started/traductions', label: 'Traductions' },
    { href: '/theming/tag-customization', label: 'Personnaliser le préfixe des tags' },
]);

const resourcesLinks: NavLink[] = withCurrent([]);

// ─── Composants (dynamique depuis CEM + MDX) ────────────────────────────────

interface NavChild {
    href:        string;
    label:       string;
    ariaCurrent: 'page' | undefined;
}

interface NavItem {
    href:        string;
    label:       string;
    ariaCurrent: 'page' | undefined;
    children:    NavChild[];
}

const allComponents: CemDeclaration[] = getCustomElements(manifest);

const allMdx   = await getCollection('components');
const mdxByTag = Object.fromEntries(allMdx.map((e) => [e.data.tagName, e]));

const childrenByParent = allComponents.reduce<Record<string, CemDeclaration[]>>(
    (acc, c) => {
        const parent = c['x-parent'];
        if (!parent) return acc;
        (acc[parent] ??= []).push(c);
        return acc;
    },
    {}
);

const componentItems: NavItem[] = allComponents
    .filter((c) => !c['x-parent'])
    .map((c) => {
        const href     = '/components/' + getSlug(c.tagName!);
        const rawChildren = childrenByParent[c.tagName!] ?? [];

        return {
            href,
            label:       mdxByTag[c.tagName!]?.data.title ?? c.name,
            ariaCurrent: currentPath === href ? ('page' as const) : undefined,
            children:    rawChildren.map((child) => {
                const childHref = '/components/' + getSlug(child.tagName!);
                return {
                    href:        childHref,
                    label:       mdxByTag[child.tagName!]?.data.title ?? child.name,
                    ariaCurrent: currentPath === childHref ? ('page' as const) : undefined,
                };
            }),
        };
    });
---

<nav aria-label="Design System">
    <div class="nav-container">
        <div class="nav-section">
            <h2>Bien démarrer</h2>
            <ul class="nav-list">
                {gettingStartedLinks.map((link) => (
                    <li>
                        <a href={link.href} aria-current={link.ariaCurrent}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </div>

        <div class="nav-section">
            <h2>Thème & Personnalisation</h2>
            <ul class="nav-list">
                {themingLinks.map((link) => (
                    <li>
                        <a href={link.href} aria-current={link.ariaCurrent}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </div>

        {advancedUsageLinks.length > 0 && (
            <div class="nav-section">
                <h2>Utilisations avancées</h2>
                <ul class="nav-list">
                    {advancedUsageLinks.map((link) => (
                        <li>
                            <a href={link.href} aria-current={link.ariaCurrent}>{link.label}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}

        {resourcesLinks.length > 0 && (
            <div class="nav-section">
                <h2>Ressources</h2>
                <ul class="nav-list">
                    {resourcesLinks.map((link) => (
                        <li>
                            <a href={link.href} aria-current={link.ariaCurrent}>{link.label}</a>
                        </li>
                    ))}
                </ul>
            </div>
        )}

        <div class="nav-section">
            <h2>Composants</h2>
            <ul class="nav-list">
                {componentItems.map((item) => (
                    <li class={item.children.length ? 'has-children' : ''}>
                        <a href={item.href} aria-current={item.ariaCurrent}>{item.label}</a>
                        {item.children.length > 0 && (
                            <ul class="nav-children">
                                {item.children.map((child) => (
                                    <li>
                                        <a href={child.href} aria-current={child.ariaCurrent}>
                                            {child.label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </li>
                ))}
            </ul>
        </div>
    </div>
</nav>

<style>
    nav {
        display:         flex;
        flex-direction:  column;
        justify-content: space-between;
        flex-grow:       1;
        padding:         2.75rem 1.25rem 3rem calc(var(--doc-nav-bead-size) / 2);
        background:      var(--doc-nav-bg);
        position:        sticky;
        top:             0;
        height:          100%;
        overflow-y:      auto;
        scrollbar-width: thin;
        scrollbar-color: var(--doc-border) transparent;
    }

    nav::-webkit-scrollbar       { width: 4px; }
    nav::-webkit-scrollbar-thumb { background: var(--doc-border); border-radius: 4px; }

    /* ── Marque (masquée sur desktop, le header a déjà le logo) ── */

    .nav-brand {
        font-weight:     var(--doc-font-weight-medium);
        font-size:       .8rem;
        letter-spacing:  -0.02em;
        color:           var(--doc-text);
        text-decoration: none;
        margin: 0;
        flex-shrink:     0;
    }

    .brand-accent {
        color: var(--ar-color-interactive);
    }

    /* ── Sections ────────────────────────────────────────────── */

    .nav-container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        row-gap: 2rem;
    }

    .nav-section {
        position: relative;
    }

    .nav-section > .nav-list {
        position: relative;
        padding-inline-start: var(--doc-nav-padding-inline-start);
    }

    .nav-section > .nav-list::before {
        content: '';
        position: absolute;
        inset-inline-start: 0;
        top: 0.35rem;
        bottom: 0.35rem;
        width: 1px;
        background: var(--doc-rail);
    }

    .nav-section h2 {
        font-size: 0.7rem;
        font-weight: var(--doc-font-weight-semibold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--doc-text-muted);
        margin:         0 0 0.5rem;
    }

    /* ── Listes ──────────────────────────────────────────────── */

    .nav-list,
    .nav-children {
        list-style: none;
        margin:     0;
        padding:    0;
    }

    .nav-list,
    .has-children,
    .nav-children {
        display: flex;
        flex-direction: column;
        row-gap: 0.5rem;
    }

    .nav-list a {
        position: relative;
        display: block;
        color: var(--doc-text-subtle);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 300;
        transition: color 0.15s;
    }

    .nav-list a:hover {
        color: var(--doc-text);
    }

    /* La perle : marque la position courante sur le fil. */
    .nav-list a[aria-current='page'] {
        color: var(--doc-text);
        font-weight: 600;
    }

    .nav-list a:hover::before,
    .nav-list a[aria-current='page']::before {
        content: '';
        position: absolute;
        /** On prend en compte le padding, - 50% de la largeur de la bille, -50% de l'épaisseur de la ligne */
        inset-inline-start: calc(var(--doc-nav-padding-inline-start) * -1  - var(--doc-nav-bead-size) / 2 + (1px /2));
        top: .4rem;
        width: var(--doc-nav-bead-size);
        height: var(--doc-nav-bead-size);
        border-radius: 50%;
    }

    .nav-list a:not([aria-current='page']):hover::before {
        background: var(--doc-bead-ring);
        box-shadow: inset 0 0 0 1px var(--doc-bead), 0 0 0 3px var(--doc-bead-ring);
    }

    .nav-list a[aria-current='page']::before {
        background: var(--doc-bead);
        box-shadow: 0 0 0 3px var(--doc-bead-ring);
    }

    /* ── Sous-composants : UN niveau, rail continu ───────────────────
       Le rail du parent (`.nav-section > .nav-list::before`) s'étend déjà
       sur toute la hauteur du <ul> — y compris les enfants dépliés, sans
       aucun code supplémentaire. Un sous-composant ne démarre donc pas son
       propre segment : il prolonge celui de son parent (contrairement aux
       grandes sections, qui n'ont rien en commun). Seule une coche
       horizontale marque le décrochage vers chaque feuille. */

    .nav-children li {
        position: relative;
    }

    .nav-children a {
        display: block;
        padding-inline-start: 1.25rem;
        color: var(--doc-text-subtle);
    }

    .nav-children li::before,
    .nav-children li::after {
        content: '';
        position: absolute;
        inset-inline-start: .2rem;
        inset-block-start: 55%;
        background: var(--doc-rail);
    }

    .nav-children li::before {
        width: 0.75rem;
        height: 1px;
    }

    .nav-children li::after {
        height: auto;
        width: 1px;
        inset-block-start: 0;
        inset-block-end: 45%;
    }



    /* La perle d'un sous-composant actif reste sur l'axe du rail de
       section (pas sur son propre retrait, qui n'est qu'un padding interne
       n'affectant pas la boîte de positionnement) — même axe que les
       items de premier niveau : hérite donc de la même formule que
       `.nav-list a[aria-current='page']::before`, aucun ajustement requis. */

    /* ── Footer nav ──────────────────────────────────────────── */

    .nav-footer-version {
        flex-shrink: 0;
        margin:      0;
        padding:     0.75rem 0.75rem 0.5rem;
        border-top:  1px solid var(--doc-border);
        font-size:   0.7rem;
        font-family: var(--doc-font-mono);
        color:       var(--doc-text-muted);
    }
</style>
