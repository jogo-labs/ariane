---
/**
 * ComponentApi.astro
 *
 * Affiche l'API complète d'un composant à partir des données du Custom Elements Manifest.
 * Toutes les sections (attributs, events, CSS parts, CSS props, slots) sont auto-générées.
 * Ajouter une annotation JSDoc dans le composant TS → apparaît ici automatiquement.
 */
import { type CemDeclaration, getPublicMethods } from '../utils/cem-types.ts';
import { isCancelableEvent, stripCancelableMarker } from '../utils/events.ts';
import { getSlug } from '../utils/tag-name.ts';
import { isTransversePart } from '../utils/transverse-roles.ts';
import { isStatePart } from '../utils/state-parts.ts';
import CodeBlock from './CodeBlock.astro';
import HeadingAnchor from './HeadingAnchor.astro';

interface RelatedTokens {
    component:   string;
    description: string;
}

interface Props {
    component:      CemDeclaration;
    relatedTokens?: RelatedTokens[];
}

const { component, relatedTokens = [] } = Astro.props;

const publicMethods = getPublicMethods(component);

const panelProps = (component.cssProperties ?? []).filter((p) => p.name.startsWith('--ar-panel-'));
const ownProps = (component.cssProperties ?? []).filter((p) => !p.name.startsWith('--ar-panel-'));

const hasTransverseParts = (component.cssParts ?? []).some((p) =>
    isTransversePart(p.name, component.tagName ?? ''),
);
const hasStateParts = (component.cssParts ?? []).some((p) => isStatePart(p.name));

const reflectsByFieldName = new Map(
    (component.members ?? []).map((m) => [m.name, m.reflects === true]),
);

interface ApiCategory {
    key:   string;
    label: string;
    count: number;
}

const categories: ApiCategory[] = [
    component.attributes && component.attributes.length > 0
        ? { key: 'attributs', label: 'Attributs et propriétés', count: component.attributes.length }
        : null,
    component.slots && component.slots.length > 0
        ? { key: 'slots', label: 'Slots', count: component.slots.length }
        : null,
    component.events && component.events.length > 0
        ? { key: 'evenements', label: 'Événements', count: component.events.length }
        : null,
    publicMethods.length > 0
        ? { key: 'methodes', label: 'Méthodes', count: publicMethods.length }
        : null,
    component.cssParts && component.cssParts.length > 0
        ? { key: 'css-parts', label: 'CSS Parts', count: component.cssParts.length }
        : null,
    (ownProps.length > 0 || panelProps.length > 0 || relatedTokens.length > 0)
        ? { key: 'css-props', label: 'CSS Custom Properties', count: ownProps.length + panelProps.length }
        : null,
].filter((c): c is ApiCategory => c !== null);

const firstCategory = categories[0]?.key ?? 'attributs';

const slug = getSlug(component.tagName!);
const codeImportCdn = `<script type="module" src="https://unpkg.com/@ariane-ui/core/dist/components/${slug}/index.js"></script>`;
const codeImportNpm = `import '@ariane-ui/core/dist/components/${slug}/index.js';`;
---

<div class="component-api">

    {/* ── Import ── */}
    <section>
        <div class="subsection-title-row">
            <h4 id="api-import" class="subsection-title">Import</h4>
            <HeadingAnchor id="api-import" label="Import" />
        </div>

        <p>
            Si vous utilisez <a href="/getting-started/quickstart#autoloader">l'autoloader</a>, les composants détectés dans la pages sont chargés automatiquement, donc pas besoin de les importer individuellement.<br />
            Pour un import manuel, voici comment vous y prendre.
        </p>

        <ar-tab-group active="cdn" label="Méthode d'import" class="api-tabs import-tabs">
            <ar-tab panel="cdn">CDN</ar-tab>
            <ar-tab panel="npm">npm</ar-tab>

            <ar-tab-panel name="cdn">
                <p>Importez ce composant depuis le CDN.</p>
                <CodeBlock code={codeImportCdn} lang="html" />
            </ar-tab-panel>

            <ar-tab-panel name="npm">
                <p>Après avoir <a href="/getting-started/quickstart#npm">installé le paquet via npm</a>, vous pouvez importer le composant ainsi :</p>
                <CodeBlock code={codeImportNpm} lang="typescript" />
            </ar-tab-panel>
        </ar-tab-group>
    </section>

    {/* ── Traduction ── */}
    {component['x-localized'] && (
        <section>
            <div class="subsection-title-row">
                <h4 id="api-traduction" class="subsection-title">Traduction</h4>
                <HeadingAnchor id="api-traduction" label="Traduction" />
            </div>
            <p>
                La langue de ce composant suit l'attribut <code>lang</code> de la page
                (<code>&lt;html lang&gt;</code>).<br /> Vous pouvez appliquer une langue différente à une
                instance donnée en posant l'attribut <code>lang</code> directement dessus.<br /> Voir la
                page <a href="/getting-started/traductions">Traductions</a> pour le détail du
                mécanisme et la liste des traductions disponibles.
            </p>
            <p>
                <code>lang</code> étant un attribut HTML natif, il n'apparaît pas dans le tableau
                « Attributs &amp; Propriétés ».
            </p>
        </section>
    )}

    {/* ── Référence API : une catégorie par onglet, ar-tab-group gère
         entièrement l'ARIA/le clavier (déjà publié, packages/core). ── */}
    {categories.length > 0 && (
        <ar-tab-group active={firstCategory} label="Référence API" class="api-tabs">
            {categories.map((cat) => (
                <ar-tab panel={cat.key}>
                    <span>{cat.label}</span><span class="api-tab-count">&nbsp;{cat.count}</span>
                </ar-tab>
            ))}

            {component.attributes && component.attributes.length > 0 && (
                <ar-tab-panel name="attributs">
                    <h4 id="api-attributs" class="sr-only">Attributs et propriétés</h4>
                    <div class="api-list" role="list">
                        {component.attributes.map((attr, i) => (
                            <div class="api-row" role="listitem">
                                <span class="sr-only">{i + 1} sur {component.attributes!.length}</span>
                                <div>
                                    <span class="api-name">
                                        {attr.name}
                                        {reflectsByFieldName.get(attr.fieldName ?? attr.name) && (
                                            <span class="flag">reflète</span>
                                        )}
                                    </span>
                                    <code class="api-sig">{attr.type?.text ?? '—'}</code>
                                    {attr.default !== undefined && (
                                        <code class="api-default">défaut&nbsp;: {attr.default}</code>
                                    )}
                                </div>
                                <p class="api-desc">{attr.description ?? ''}</p>
                            </div>
                        ))}
                    </div>
                </ar-tab-panel>
            )}

            {component.slots && component.slots.length > 0 && (
                <ar-tab-panel name="slots">
                    <h4 id="api-slots" class="sr-only">Slots</h4>
                    <div class="api-list" role="list">
                        {component.slots.map((slot, i) => (
                            <div class="api-row" role="listitem">
                                <span class="sr-only">{i + 1} sur {component.slots!.length}</span>
                                <span class="api-name">{slot.name || '(default)'}</span>
                                <p class="api-desc">{slot.description ?? ''}</p>
                            </div>
                        ))}
                    </div>
                </ar-tab-panel>
            )}

            {component.events && component.events.length > 0 && (
                <ar-tab-panel name="evenements">
                    <h4 id="api-evenements" class="sr-only">Événements</h4>
                    <div class="api-list" role="list">
                        {component.events.map((event, i) => (
                            <div class="api-row" role="listitem">
                                <span class="sr-only">{i + 1} sur {component.events!.length}</span>
                                <span class="api-name">
                                    {event.name}
                                    {isCancelableEvent(event.description) && <span class="flag">annulable</span>}
                                </span>
                                <p class="api-desc">{stripCancelableMarker(event.description)}</p>
                            </div>
                        ))}
                    </div>
                </ar-tab-panel>
            )}

            {publicMethods.length > 0 && (
                <ar-tab-panel name="methodes">
                    <h4 id="api-methodes" class="sr-only">Méthodes</h4>
                    <div class="api-list" role="list">
                        {publicMethods.map((m, i) => {
                            const params = (m.parameters ?? [])
                                .map((p) => {
                                    let s = p.name;
                                    if (p.type?.text) s += `: ${p.type.text}`;
                                    if (p.default !== undefined) s += ` = ${p.default}`;
                                    return s;
                                })
                                .join(', ');
                            const returnType = m.return?.type?.text ?? 'void';
                            return (
                                <div class="api-row" role="listitem">
                                    <span class="sr-only">{i + 1} sur {publicMethods.length}</span>
                                    <div>
                                        <span class="api-name">{m.name}()</span>
                                        {params && <code class="api-sig">{params}</code>}
                                        <code class="api-default">retour&nbsp;: {returnType}</code>
                                    </div>
                                    <p class="api-desc">{m.description ?? ''}</p>
                                </div>
                            );
                        })}
                    </div>
                </ar-tab-panel>
            )}

            {component.cssParts && component.cssParts.length > 0 && (
                <ar-tab-panel name="css-parts">
                    <h4 id="api-css-parts" class="sr-only">CSS Parts</h4>
                    <p class="hint">
                        Utilisez <code>::part(name)</code> pour styler ces éléments depuis l'extérieur.
                        {hasTransverseParts && (
                            <>
                                <br />Certaines parts indiquent un rôle transverse, partagé avec
                                d'autres composants — voir <a href="/theming/personnalisation-avancee#semantic-parts">Personnalisation avancée</a>.
                            </>
                        )}
                        {hasStateParts && (
                            <>
                                <br />Certaines parts portent un modificateur d'état (<code>--</code>) — voir <a href="/theming/personnalisation-avancee#state-parts">Personnalisation avancée</a>.
                            </>
                        )}
                    </p>
                    <div class="api-list" role="list">
                        {component.cssParts.map((part, i) => (
                            <div class="api-row" role="listitem">
                                <span class="sr-only">{i + 1} sur {component.cssParts!.length}</span>
                                <span class="api-name">{part.name}</span>
                                <p class="api-desc">{part.description ?? ''}</p>
                            </div>
                        ))}
                    </div>
                </ar-tab-panel>
            )}

            {(ownProps.length > 0 || panelProps.length > 0 || relatedTokens.length > 0) && (
                <ar-tab-panel name="css-props">
                    <h4 id="api-css-props" class="sr-only">CSS Custom Properties</h4>
                    {panelProps.length > 0 && (
                        <>
                            <p>
                                Ce composant utilise un panel flottant, partagé avec d'autres composants, qui expose des custom properties.<br />
                                Les thèmes peuvent redéfinir ces tokens globalement via <code>:root</code>, ou par composant comme dans cet exemple :
                            </p>
                            <div class="token-example">
                                <pre><code class="language-css">{`${component.tagName} {\n    --ar-panel-radius: 1rem;\n}`}</code></pre>
                            </div>
                            <div class="api-list panel-tokens-list" role="list">
                                {panelProps.map((prop, i) => (
                                    <div class="api-row" role="listitem">
                                        <span class="sr-only">{i + 1} sur {panelProps.length}</span>
                                        <span class="api-name">{prop.name}</span>
                                        <p class="api-desc">{prop.description ?? ''}</p>
                                    </div>
                                ))}
                            </div>
                        </>
                    )}
                    {(panelProps.length > 0 && ownProps.length > 0) && (
                        <p class="own-props-intro">Il expose également des custom properties propres, personnalisables directement via <code>:root</code>.</p>
                    )}
                    {ownProps.length > 0 && (
                        <div class="api-list" role="list">
                            {ownProps.map((prop, i) => (
                                <div class="api-row" role="listitem">
                                    <span class="sr-only">{i + 1} sur {ownProps.length}</span>
                                    <span class="api-name">{prop.name}</span>
                                    <p class="api-desc">{prop.description ?? ''}</p>
                                </div>
                            ))}
                        </div>
                    )}
                    {relatedTokens.length > 0 && (
                        <ar-alert class="doc-callout-alert" variant="info" without-notification>
                            <div class="doc-callout-alert-content">
                                {relatedTokens.map((rt) => (
                                    <p>
                                        {rt.description}{' '}<br />
                                        <a href={`/components/${getSlug(rt.component)}#api-css-props`}>Voir les tokens de <code>{rt.component}</code></a>.
                                    </p>
                                ))}
                            </div>
                        </ar-alert>
                    )}
                </ar-tab-panel>
            )}
        </ar-tab-group>
    )}
</div>

<style>
    @import '../styles/doc-prose.css';

    .component-api {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        margin-top: 2rem;
    }

    .hint {
        margin-bottom: 0.75rem;
    }

    .token-example {
        margin-bottom: 1rem;
    }

    .own-props-intro {
        margin-top: 1.875rem;
    }

    .token-example pre {
        margin: 0;
        padding: 1rem 1.25rem;
        overflow-x: auto;
        border-radius: 0.5rem;
        font-family: var(--doc-font-mono);
        font-size: 0.8rem;
        line-height: 1.6;
        background: var(--doc-code-block-bg);
    }

    .token-example pre code {
        font-family: inherit;
        font-size: inherit;
        padding: 0;
        background: transparent;
        color: var(--doc-code-base);
    }

    /* ── Onglets ──────────────────────────────────────────── */

    .api-tabs {
        display: block;
        --ar-tab-padding-x: .9rem;

        ar-tab:not([active]):hover .api-tab-count {
            color: var(--doc-text);
        }
    }

    .import-tabs {
        --ar-tab-padding-x: 2rem;
    }

    /* doc-code-block.css ne pose volontairement aucun border-radius sur
       .code-block (cf. son commentaire d'en-tête) — boîte autonome ici
       (pas de panneau bordé englobant comme dans Playground), donc à
       poser ici. :global() car .code-block est rendu par le composant
       enfant CodeBlock, hors du scope Astro de ce fichier. */
    .import-tabs :global(.code-block) {
        border-radius: 0.5rem;
    }

    .api-tab-count {
        font-family: var(--doc-font-mono);
        font-size: 0.8rem;
        color: var(--doc-text-muted);
        font-weight: var(--doc-font-weight-thin);
        transition: color .35s var(--doc-ease)
    }

    /* ── API en « lignes de vie » — remplace les tableaux : plus de
           scroll horizontal en mobile. ─────────────────────────────── */

    .api-list {
        display: flex;
        flex-direction: column;
        padding-block-start: .5rem;
    }

    .panel-tokens-list {
        margin-bottom: 1.875rem;
    }

    .api-row {
        display: grid;
        grid-template-columns: 15.5rem minmax(0, 1fr);
        gap: 0 1.75rem;
        padding: 0.95rem 0 0.95rem 1.15rem;
        position: relative;
        border-top: 1px solid var(--doc-border);
    }

    .api-row:first-child {
        border-top: 0;
    }

    /* Le fil relie toutes les entrées de la catégorie. */
    .api-row::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--doc-rail);
    }

    .api-row:first-child::before {
        top: 0.95rem;
    }
    .api-row:last-child::before {
        bottom: 0.95rem;
    }

    .api-row::after {
        content: '';
        position: absolute;
        left: -3px;
        top: 1.35rem;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--doc-bead-ring);
        border: 1px solid var(--doc-rail);
    }

    .api-row:hover::after {
        background: var(--doc-bead);
        border-color: var(--doc-bead);
    }

    .api-name {
        font-family: var(--doc-font-mono);
        font-size: 0.86rem;
        font-weight: var(--doc-font-weight-medium);
        color: var(--doc-text);
        word-break: break-word;
    }

    .api-sig {
        display: block;
        font-family: var(--doc-font-mono);
        font-size: var(--doc-font-size-xs);
        color: var(--doc-accent);
        margin-top: 0.2rem;
        line-height: 1.5;
        background: transparent;
        padding: 0;
    }

    .api-default {
        display: block;
        font-family: var(--doc-font-mono);
        font-size: 0.72rem;
        color: var(--doc-text-muted);
        margin-top: 0.15rem;
        background: transparent;
        padding: 0;
    }

    .api-desc {
        font-size: var(--doc-font-size-sm);
        color: var(--doc-text-muted);
        margin: 0;
    }

    .api-desc code {
        font-family: var(--doc-font-mono);
        font-size: 0.84em;
        background: var(--doc-surface);
        padding: 0.05rem 0.3rem;
        border-radius: var(--doc-radius-sm);
        color: var(--doc-text);
    }

    .flag {
        display: inline-block;
        font-size: 0.66rem;
        font-weight: var(--doc-font-weight-semibold);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.05rem 0.4rem;
        border-radius: 999px;
        border: 1px solid var(--doc-accent);
        color: var(--doc-accent);
        margin-left: 0.4rem;
        vertical-align: 1px;
    }

    @media (max-width: 900px) {
        .api-row {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.4rem;
        }
    }
</style>
