---
/**
 * ComponentApi.astro
 *
 * Affiche l'API complète d'un composant à partir des données du Custom Elements Manifest.
 * Toutes les sections (attributs, events, CSS parts, CSS props, slots) sont auto-générées.
 * Ajouter une annotation JSDoc dans le composant TS → apparaît ici automatiquement.
 */
import { type CemDeclaration, getPublicMethods } from '../utils/cem-types.ts';
import { isCancelableEvent, stripCancelableMarker } from '../utils/events.ts';
import { getSlug } from '../utils/tag-name.ts';
import { isTransversePart } from '../utils/transverse-roles.ts';

interface RelatedTokens {
    component:   string;
    description: string;
}

interface Props {
    component:      CemDeclaration;
    relatedTokens?: RelatedTokens[];
}

const { component, relatedTokens = [] } = Astro.props;

const publicMethods = getPublicMethods(component);

const panelProps = (component.cssProperties ?? []).filter((p) => p.name.startsWith('--ar-panel-'));
const ownProps = (component.cssProperties ?? []).filter((p) => !p.name.startsWith('--ar-panel-'));

const hasTransverseParts = (component.cssParts ?? []).some((p) =>
    isTransversePart(p.name, component.tagName ?? ''),
);
---

<div class="component-api">

    {/* ── Traduction ── */}
    {component['x-localized'] && (
        <section>
            <h4 id="api-traduction" class="subsection-title">Traduction</h4>
            <p>
                La langue de ce composant suit l'attribut <code>lang</code> de la page
                (<code>&lt;html lang&gt;</code>).<br> Vous pouvez appliquer une langue différente à une
                instance donnée en posant l'attribut <code>lang</code> directement dessus.<br> Voir la
                page <a href="/getting-started/i18n">Internationalisation</a> pour le détail du
                mécanisme et la liste des traductions disponibles.
            </p>
            <p>
                <code>lang</code> étant un attribut HTML natif, il n'apparaît pas dans le tableau
                « Attributs &amp; Propriétés » ci-dessous.
            </p>
        </section>
    )}

    {/* ── Attributs & Propriétés ── */}
    {component.attributes && component.attributes.length > 0 && (
        <section>
            <h4 id="api-attributs" class="subsection-title">Attributs &amp; Propriétés</h4>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Type</th>
                            <th scope="col">Défaut</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {component.attributes.map((attr) => (
                            <tr>
                                <td><code>{attr.name}</code></td>
                                <td><code>{attr.type?.text ?? '—'}</code></td>
                                <td><code>{attr.default ?? '—'}</code></td>
                                <td>{attr.description ?? ''}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    )}

    {/* ── Événements ── */}
    {component.events && component.events.length > 0 && (
        <section>
            <h4 id="api-evenements" class="subsection-title">Événements</h4>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Description</th>
                            <th scope="col">Annulable</th>
                        </tr>
                    </thead>
                    <tbody>
                        {component.events.map((event) => (
                            <tr>
                                <td><code>{event.name}</code></td>
                                <td>{stripCancelableMarker(event.description)}</td>
                                <td>{isCancelableEvent(event.description) ? 'Oui' : 'Non'}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    )}

    {/* ── Méthodes ── */}
    {publicMethods.length > 0 && (
        <section>
            <h4 id="api-methodes" class="subsection-title">Méthodes</h4>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Paramètres</th>
                            <th scope="col">Retour</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {publicMethods
                            .map((m) => {
                                const params = (m.parameters ?? [])
                                    .map((p) => {
                                        let s = p.name;
                                        if (p.type?.text) s += `: ${p.type.text}`;
                                        if (p.default !== undefined) s += ` = ${p.default}`;
                                        return s;
                                    })
                                    .join(', ');
                                const returnType = m.return?.type?.text ?? 'void';
                                return (
                                    <tr>
                                        <td><code>{m.name}()</code></td>
                                        <td>{params ? <code>{params}</code> : <span class="muted">—</span>}</td>
                                        <td><code>{returnType}</code></td>
                                        <td>{m.description ?? ''}</td>
                                    </tr>
                                );
                            })}
                    </tbody>
                </table>
            </div>
        </section>
    )}

    {/* ── CSS Parts ── */}
    {component.cssParts && component.cssParts.length > 0 && (
        <section>
            <h4 id="api-css-parts" class="subsection-title">CSS Parts</h4>
            <p class="hint">
                Utilisez <code>::part(name)</code> pour styler ces éléments depuis l'extérieur.
                {hasTransverseParts && (
                    <>
                        <br>Certaines parts ci-dessous indiquent un rôle transverse, partagé avec
                        d'autres composants — voir les <a href="/getting-started/naming-conventions">conventions de nommage</a>.
                    </>
                )}
            </p>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {component.cssParts.map((part) => (
                            <tr>
                                <td><code>{part.name}</code></td>
                                <td>{part.description ?? ''}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    )}

    {/* ── CSS Custom Properties propres au composant ── */}
    {(ownProps.length > 0 || panelProps.length > 0 || relatedTokens.length > 0) && (
        <section>
            <h4 id="api-css-props" class="subsection-title">CSS Custom Properties</h4>
            {/* ── Tokens du panel partagé (affiché en premier si présent) ── */}
            {panelProps.length > 0 && (
                <p>
                    Ce composant utilise un panel flottant, partagé avec d'autres composants, qui expose des custom properties.<br>
                    Les thèmes peuvent redéfinir ces tokens globalement via <code>:root</code>, ou par composants comme ci-dessous.
                </p>
                <div class="token-example">
                    <pre><code class="language-css">{`${component.tagName} {\n    --ar-panel-radius: 1rem;\n}`}</code></pre>
                </div>
                <div class="table-wrap panel-tokens-table">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Nom</th>
                                <th scope="col">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            {panelProps.map((prop) => (
                                <tr>
                                    <td><code>{prop.name}</code></td>
                                    <td>{prop.description ?? ''}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
            {(panelProps.length > 0 && ownProps.length > 0) && (
                <p class="own-props-intro">Il expose également des custom properties propres, personnalisables directement via <code>:root</code>.</p>
            )}
            {ownProps.length > 0 && (
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">Nom</th>
                                <th scope="col">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            {ownProps.map((prop) => (
                                <tr>
                                    <td><code>{prop.name}</code></td>
                                    <td>{prop.description ?? ''}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
            {/* ── Tokens d'un composant imbriqué en interne (ex. tooltip dans table-sort) ── */}
            {relatedTokens.length > 0 && (
                <ar-alert class="doc-callout-alert" variant="info" without-notification>
                    <div class="doc-callout-alert-content">
                        {relatedTokens.map((rt) => (
                            <p>
                                {rt.description}{' '}<br>
                                <a href={`/components/${getSlug(rt.component)}#api-css-props`}>Voir les tokens de <code>{rt.component}</code></a>.
                            </p>
                        ))}
                    </div>
                </ar-alert>
            )}
        </section>
    )}

    {/* ── Slots ── */}
    {component.slots && component.slots.length > 0 && (
        <section>
            <h4 id="api-slots" class="subsection-title">Slots</h4>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        {component.slots.map((slot) => (
                            <tr>
                                <td><code>{slot.name || '(default)'}</code></td>
                                <td>{slot.description ?? ''}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>
    )}
</div>

<style>
    @import '../styles/doc-prose.css';
    @import '../styles/doc-table.css';

    .component-api {
        display:        flex;
        flex-direction: column;
        gap:            2.5rem;
        margin-top:     2rem;
    }

    .hint {
        font-size:     0.875rem;
        color:         var(--doc-text-muted);
        margin-bottom: 0.75rem;
    }

    .token-example {
        margin-bottom: 1rem;
    }

    .panel-tokens-table {
        margin-bottom: 1.875rem;
    }

    .own-props-intro {
        margin-top: 1.875rem;
    }

    .token-example pre {
        margin:         0;
        padding:        1rem 1.25rem;
        overflow-x:     auto;
        border-radius:  0.5rem;
        font-family:    'Fira Code', 'Cascadia Code', monospace;
        font-size:      0.8rem;
        line-height:    1.6;
        background:     var(--doc-code-block-bg);
    }

    .token-example pre code {
        font-family: inherit;
        font-size:   inherit;
        padding:     0;
        background:  transparent;
        color:       #cdd6f4;
    }
</style>
