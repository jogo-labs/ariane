---
/**
 * naming-conventions.astro
 *
 * Stub de redirection vers /theming/parts-and-slots (page renommée/déplacée).
 * Remplace la redirection statique déclarée dans astro.config.mjs : celle-ci
 * perd tout fragment d'URL (#semantic-parts…), cassant les liens externes
 * vers une ancre précise de l'ancienne page. Ce stub redirige côté client en
 * reconstruisant l'URL cible avec le hash courant.
 */
const target = '/theming/parts-and-slots/';
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta http-equiv="refresh" content={`0;url=${target}`} />
        <meta name="robots" content="noindex" />
        <link rel="canonical" href={target} />
        <title>Redirection vers Parts & Slots</title>
        <script is:inline define:vars={{ target }}>
            window.location.replace(target + window.location.hash);
        </script>
    </head>
    <body>
        <a href={target}>Redirection de <code>/getting-started/naming-conventions</code> vers <code>{target}</code></a>
    </body>
</html>
