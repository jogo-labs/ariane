---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import NarrativeHeading from '../../components/NarrativeHeading.astro';
import NarrativeSubheading from '../../components/NarrativeSubheading.astro';

const tocEntries = [
    { id: 'principe',           label: 'Fonctionnement',                level: 1 as const },
    { id: 'locale-resolution',  label: 'Résolution de la langue',       level: 2 as const },
    { id: 'default-imports',    label: 'Imports par défaut',            level: 2 as const },
    { id: 'traductions',        label: 'Créer votre propre traduction', level: 1 as const },
    { id: 'traductions-cdn',    label: 'Avec le CDN',                   level: 2 as const },
    { id: 'traductions-npm',    label: 'Avec le paquet NPM',            level: 2 as const },
    { id: 'traductions-disponibles', label: 'Traductions disponibles',  level: 1 as const },
];

const codeChangeLang = `<!-- Langue par défaut de la page -->
<html lang="en">

<!-- Ou par composant, en surcharge -->
<ar-table-sort lang="es">Prix</ar-table-sort>`;

const codeCustomTranslationCdnImportModule = `// es.js — copie de fr.ts, traduite terme par terme, sans import ni typage (usage CDN)

const translation = {
    $code: 'es',
    $name: 'Español',
    $dir: 'ltr',

    // ... tous les termes de fr.ts, traduits
    term1: '...',
    term2: '...',
};

export default translation;`;

const codeCustomTranslationCdnImport = `<html lang="es">
  <head>
    <!-- Enregistrez votre traduction -->
    <script type="module">
      import { registerTranslation } from 'https://unpkg.com/@ariane-ui/core@<version>/cdn/utils.js';
      import translation from './translations/es.js';
      registerTranslation(translation);
    </script>

    <!-- Puis chargez les composants -->
    <script type="module" src="https://unpkg.com/@ariane-ui/core/cdn/autoloader.js"></script>
  </head>

  <body>
    ...
  </body>
</html>
`;

const codeCustomTranslationNpm = `// es.ts — copie de fr.ts, traduite terme par terme
import { registerTranslation } from '@ariane-ui/core/utils';
import type { Translation } from '@ariane-ui/core/utils';

const translation: Translation = {
    $code: 'es',
    $name: 'Español',
    $dir: 'ltr',

    // ... tous les termes de fr.ts, traduits
    term1: '...',
    term2: '...',
};

registerTranslation(translation);

export default translation;`;

const codeCustomTranslationNpmImport = `// main.js (ou layout racine)
import '@ariane-ui/core'; // les composants
import './translations/es.js'; // votre traduction (importée après, le français reste la langue de repli)`;
---

<Layout title="Traductions" currentPath="/getting-started/traductions" showToc={true}>
    <div class="page-container">
        <div class="page-header">
            <h2 class="page-title">Traductions</h2>
            <p class="summary">
                Certains composants Ariane embarquent des libellés accessibles (annonces
                aria-live, aria-label). Ce mécanisme permet de les traduire sans surcharger
                chaque instance manuellement.
            </p>
        </div>

        <div class="narrative">
            <NarrativeHeading id="principe">Fonctionnement</NarrativeHeading>
            <p>
                Ariane s'appuie sur la micro-librairie{' '}
                <a href="https://github.com/shoelace-style/localize"
                target="_blank" rel="noopener">@shoelace-style/localize</a> pour fournir un mécanisme de traduction de ses composants.
            </p>

            <NarrativeSubheading id="locale-resolution">Résolution de la langue</NarrativeSubheading>
            <p>
                La langue par défaut est déterminée par la valeur de l'attribut <code>&lt;html lang&gt;</code>, mais l'ajout d'un attribut <code>lang</code> sur un composant permet une surcharge locale.<br />
                Si aucun des deux attributs n'est présent, c'est la langue du navigateur
                (<code>navigator.language</code>) qui est utilisé.<br />
                Dans tous les cas s'il n'existe pas de traduction pour la langue identifiée, c'est le français qui sera utilisé.
            </p>
            <pre><code class="language-html" set:text={codeChangeLang} /></pre>
            <ar-alert variant="warning" without-notification class="doc-callout-alert">
                <p class="doc-callout-alert-title">À savoir</p>
                <div class="doc-callout-alert-content">
                    <p>
                        Seuls <code>&lt;html lang&gt;</code> et le <code>lang</code> posé
                        directement sur le composant sont pris en compte — un <code>&lt;div lang="es"&gt;</code> autour
                        d'un composant Ariane n'a
                        aucun effet. C'est une limite assumée de la librairie, pour des
                        raisons de performance (pas de traversée du DOM à chaque rendu).
                    </p>
                </div>
            </ar-alert>

            <NarrativeSubheading id="default-imports">Imports par défaut</NarrativeSubheading>
            <p>
                Contrairement à d'autres bibliothèques qui publient un fichier par langue à
                charger à la demande, les traductions <code>fr</code> (défaut) et <code>en</code> sont
                embarquées directement dans chaque composant qui en a
                besoin (CDN ou npm). Charger <code>ar-table-sort</code> ou <code>ar-datepicker</code> suffit
                — les deux langues sont déjà enregistrées,
                aucun import supplémentaire n'est nécessaire pour les utiliser.
            </p>

            <NarrativeHeading id="traductions">Créer votre propre traduction</NarrativeHeading>
            <p>
                Que vous souhaitiez surcharger une langue fournie, ou disposer sans attendre d'une
                traduction non disponible pour votre propre langue, le mécanisme à utiliser est très
                simple.<br />
            </p>

            <NarrativeSubheading id="traductions-cdn">Avec le CDN</NarrativeSubheading>
            <p>
                Commencez par copier{' '}
                <a
                    href="https://github.com/jogo-labs/ariane/blob/main/packages/core/src/translations/fr.ts"
                    target="_blank"
                    rel="noopener"
                >
                    <code>/core/src/translations/fr.ts</code>
                </a>{' '}
                (la traduction source du package, la plus à jour) dans votre projet et traduisez
                chaque terme. <br />
                Modifiez-le pour ne garder que l'export de la traduction :
            </p>
            <pre style="margin-top: 0.85rem"><code class="language-js" set:text={codeCustomTranslationCdnImportModule} /></pre>
            <p>
                Dans votre HTML, importez ensuite l'utilitaire <code>registerTranslation</code> depuis
                <code>cdn/utils.js</code>. <br />
                En environnement de développement, utilisez <code>utils.dev.js</code> et veillez dans ce cas à charger <code>autoloader.dev.js</code> ou <code>index.dev.js</code>. Sinon, la traduction serait enregistrée dans un registre
                que les composants ne lisent pas, sans erreur visible.
            </p>
            <pre><code class="language-html" set:text={codeCustomTranslationCdnImport} /></pre>

            <NarrativeSubheading id="traductions-npm">Avec le paquet npm</NarrativeSubheading>
            <p>
                Commencez par copier{' '}
                <a
                    href="https://github.com/jogo-labs/ariane/blob/main/packages/core/src/translations/fr.ts"
                    target="_blank"
                    rel="noopener"
                >
                    <code>/core/src/translations/fr.ts</code>
                </a>{' '}
                (la traduction source du package, la plus à jour) dans votre projet et traduisez
                chaque terme. <br />
                Le type <code>Translation</code>, exporté par le package, vous
                force à fournir tous les termes attendus.
            </p>
            <pre style="margin-top: 0.85rem"><code class="language-js" set:text={codeCustomTranslationNpm} /></pre>
            <p>
                Importez votre traduction une seule fois, dans le point d'entrée de l'application ou dans
                le layout racine : le registre est partagé par tous les composants, il n'y a rien à
                importer composant par composant. Pour une langue ajoutée, l'ordre d'import n'a pas
                d'incidence sur l'affichage :
            </p>
            <pre style="margin-top: 0.85rem"><code class="language-js" set:text={codeCustomTranslationNpmImport} /></pre>

            <p class="hint">
                Deux effets de l'ordre sont à connaître. La première traduction enregistrée devient la langue de
                repli, utilisée quand la langue de la page n'a pas de traduction : enregistrer la vôtre avant
                les composants en fait la langue de repli, après, le français le reste. Et pour
                <strong>remplacer</strong> une langue fournie (<code>fr</code> ou <code>en</code>), enregistrez votre version
                <em>après</em> le chargement des composants : leurs traductions par défaut se fusionnent par-dessus ce
                qui est déjà enregistré.
            </p>

            <NarrativeHeading id="traductions-disponibles">Traductions disponibles</NarrativeHeading>
            <p>
                Chaque composant concerné documente son propre support i18n dans sa page. <br />
                Pour le détail des termes, voir les <a
                    href="https://github.com/jogo-labs/ariane/tree/main/packages/core/src/translations"
                    target="_blank"
                    rel="noopener"
                >traductions existantes sur le repo Github</a>
            </p>
        </div>
    </div>

    <TableOfContents entries={tocEntries} slot="toc" />
</Layout>

<style>
    @import '../../styles/doc-prose.css';
</style>
