---
import Layout from '../layouts/Layout.astro';
import manifest from '@cem';
import { version } from '../../../../packages/core/package.json';
import { type CemDeclaration, getCustomElements } from '../utils/cem-types.ts';
import { getSlug } from '../utils/tag-name.ts';

const allComponents: CemDeclaration[] = getCustomElements(manifest);
const rootComponents = allComponents.filter((c) => !c['x-parent']);
const componentCount = rootComponents.length;
const firstComponentHref = rootComponents[0]?.tagName
    ? '/components/' + getSlug(rootComponents[0].tagName)
    : '/components/button';
---

<Layout title="Accueil" showNav={false}>
    <!-- Hero -->
    <section class="hero">
        <h1 class="hero-title">Un fil pour construire<br />des interfaces accessibles.</h1>

        <p class="hero-pitch">
            Ariane est une fondation de Custom Elements natifs, thémables et compatibles
            avec tous les frameworks — sans imposer un look à ta place.
        </p>

        <div class="hero-ctas">
            <a href="/getting-started/quickstart" class="btn-primary">Démarrage rapide</a>
            <a href={firstComponentHref} class="btn-secondary">Voir les composants</a>
        </div>

        <ul class="hero-facts">
            <li>v{version}</li>
            <li>{componentCount} composants</li>
            <li>Licence MIT</li>
            <li>Lit 3 · TypeScript</li>
        </ul>
    </section>

    <div class="thread-divider" aria-hidden="true"></div>

    <!-- Démo live -->
    <section class="demo-section">
        <h2 class="demo-title">Des composants qui fonctionnent, pas des maquettes</h2>
        <p class="demo-pitch">
            Accessibilité, thème, positionnement — tout est déjà branché. Essayez.
        </p>

        <div class="demo-panel">
            <ar-tab-group active="alertes">
                <ar-tab panel="alertes">Alertes</ar-tab>
                <ar-tab panel="tooltip">Info-bulle</ar-tab>
                <ar-tab panel="progress">Progrès</ar-tab>

                <ar-tab-panel name="alertes" style="padding: 1.5rem">
                    <ar-alert variant="success">
                        <strong>Succès de l'opération</strong><br />
                        Le statut est annoncé automatiquement aux lecteurs d'écran.
                    </ar-alert>
                </ar-tab-panel>

                <ar-tab-panel name="tooltip" style="padding: 2.5rem 1.5rem; text-align: center">
                    <button id="home-demo-tooltip" class="btn-secondary" type="button">
                        Survolez-moi
                    </button>
                    <ar-tooltip for="home-demo-tooltip">
                        Positionné automatiquement par Floating UI
                    </ar-tooltip>
                </ar-tab-panel>

                <ar-tab-panel name="progress" style="padding: 1.5rem">
                    <ar-progressbar percent="66"></ar-progressbar>
                </ar-tab-panel>
            </ar-tab-group>
        </div>
    </section>

    <div class="thread-divider" aria-hidden="true"></div>

    <!-- Pourquoi Ariane -->
    <section class="why-section">
        <h2 class="why-title">Pourquoi Ariane</h2>

        <ul class="why-list">
            <li>
                <h3>Accessible par défaut</h3>
                <p>
                    ARIA, navigation clavier et rôles sémantiques intégrés dans chaque
                    composant. Pas une option — une exigence de base.
                </p>
            </li>
            <li>
                <h3>Indépendant du framework</h3>
                <p>
                    Custom Elements natifs : ça fonctionne avec React, Vue, Svelte, Angular
                    ou du HTML pur. Une seule librairie, partout.
                </p>
            </li>
            <li>
                <h3>Fondation pour ton design system</h3>
                <p>
                    CSS Custom Properties exposées sur chaque composant. Ariane pose les
                    fondations ; toi tu définis l'identité visuelle.
                </p>
            </li>
        </ul>
    </section>

    <div class="thread-divider" aria-hidden="true"></div>

    <!-- CTA bas de page -->
    <div class="cta-bottom">
        <h2>Prêt à commencer ?</h2>
        <p>Parcourez la documentation et le catalogue de composants.</p>
        <div class="cta-bottom-actions">
            <a href="/getting-started/quickstart" class="btn-primary">Démarrage rapide</a>
            <a href={firstComponentHref} class="btn-secondary">Explorer les composants</a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="landing-footer">
        <p>Ariane — Licence MIT</p>
        <p>
            Construit avec <a href="https://lit.dev" target="_blank" rel="noopener noreferrer">Lit 3</a>
            · <a href="https://github.com/jogo-labs/ariane" target="_blank" rel="noopener noreferrer">GitHub</a>
        </p>
    </footer>
</Layout>

<style>
    /* ── Colonne partagée ────────────────────────────────── */

    .hero,
    .demo-section,
    .why-section {
        max-width: 1100px;
        margin: 0 auto;
        padding: 3.5rem 2.5rem;
    }

    /* ── Hero ─────────────────────────────────────────────── */

    .hero {
        padding-bottom: 2.5rem;
    }

    .hero-title {
        font-family: 'Fira Code', 'Cascadia Code', monospace;
        font-weight: 700;
        font-size: clamp(1.85rem, 4.5vw, 2.85rem);
        line-height: 1.2;
        color: var(--doc-text);
        max-width: 18ch;
        margin: 0 0 1.25rem;
    }

    .hero-pitch {
        font-size: 1.05rem;
        color: var(--doc-text-subtle);
        line-height: 1.75;
        max-width: 52ch;
        margin: 0 0 2rem;
    }

    .hero-ctas {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
    }

    .hero-facts {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.8rem;
        color: var(--doc-text-muted);
    }

    .hero-facts li + li {
        border-left: 1px solid var(--doc-border);
        padding-left: 1.25rem;
    }

    /* ── Boutons ──────────────────────────────────────────── */

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--doc-accent);
        color: #fff;
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-primary:hover {
        background: var(--doc-accent-hover);
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: transparent;
        color: var(--doc-text);
        font-family: inherit;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.65rem 1.5rem;
        border-radius: 8px;
        text-decoration: none;
        border: 1.5px solid var(--doc-border);
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
    }

    .btn-secondary:hover {
        border-color: var(--doc-accent);
        color: var(--doc-accent);
    }

    /* ── Fil d'Ariane — séparateur ──────────────────────── */

    .thread-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2.5rem;
    }

    .thread-divider::before {
        content: '';
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--doc-thread);
        flex-shrink: 0;
    }

    .thread-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--doc-thread);
        opacity: 0.35;
    }

    /* ── Démo live ──────────────────────────────────────── */

    .demo-title {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--doc-text);
        margin: 0 0 0.5rem;
        max-width: 32ch;
    }

    .demo-pitch {
        font-size: 0.95rem;
        color: var(--doc-text-muted);
        margin: 0 0 2rem;
    }

    .demo-panel {
        background: var(--doc-code-bg);
        border: 1px solid var(--doc-border);
        border-radius: 12px;
        padding: 1.5rem;
    }

    /* ── Pourquoi Ariane ────────────────────────────────── */

    .why-title {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--doc-text);
        margin: 0 0 2rem;
    }

    .why-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
    }

    .why-list li {
        border-left: 2px solid var(--doc-border);
        padding-left: 1.25rem;
    }

    .why-list h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--doc-text);
        letter-spacing: -0.01em;
        margin: 0 0 0.4rem;
    }

    .why-list p {
        font-size: 0.9rem;
        color: var(--doc-text-muted);
        line-height: 1.7;
        margin: 0;
        max-width: 60ch;
    }

    /* ── CTA bas de page ────────────────────────────────── */

    .cta-bottom {
        background: var(--doc-cta-bg);
        border-top: 1px solid var(--doc-cta-border);
        border-bottom: 1px solid var(--doc-cta-border);
        text-align: center;
        padding: 4rem 2rem;
    }

    .cta-bottom h2 {
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--doc-text);
        margin-bottom: 0.5rem;
    }

    .cta-bottom p {
        font-size: 0.9rem;
        /* var(--doc-text-muted) échoue le contraste AA sur ce fond (axe-core) */
        color: var(--doc-text);
        margin-bottom: 1.75rem;
    }

    .cta-bottom-actions {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    /* ── Footer ─────────────────────────────────────────── */

    .landing-footer {
        padding: 2rem 2.5rem;
        border-top: 1px solid var(--doc-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .landing-footer p {
        font-size: 0.78rem;
        color: var(--doc-text-muted);
        margin: 0;
    }

    .landing-footer a {
        color: var(--doc-accent);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* ── Responsive ─────────────────────────────────────── */

    @media (max-width: 640px) {
        .hero,
        .demo-section,
        .why-section {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }

        .thread-divider {
            padding-left: 1.5rem;
            padding-right: 1.5rem;
        }
    }
</style>
