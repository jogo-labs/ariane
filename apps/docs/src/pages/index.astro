---
import HomeLayout from '../layouts/HomeLayout.astro';
import manifest from '@cem';
import { version } from '../../../../packages/core/package.json';
import { type CemDeclaration, getCustomElements } from '../utils/cem-types.ts';
import { getSlug } from '../utils/tag-name.ts';

const allComponents: CemDeclaration[] = getCustomElements(manifest);
const rootComponents = allComponents.filter((c) => !c['x-parent']);
const componentCount = rootComponents.length;
const firstComponentHref = rootComponents[0]?.tagName
    ? '/components/' + getSlug(rootComponents[0].tagName)
    : '/components/button';

const codeInstall = `<!-- L'autoloader détecte les composants présents pour ne charger que le nécessaire -->
<script type="module" src="https://unpkg.com/@ariane-ui/core/cdn/autoloader.prod.js"></script>

<!-- Le thème permet d'adapter le look des composants à votre charte -->
<link rel="stylesheet" href="https://unpkg.com/@ariane-ui/core/dist/styles/themes/default.css" />

<!-- Optionnel : classes de bouton prêtes à l'emploi (.ar-btn-*) pour du HTML que vous écrivez vous-même -->
<link rel="stylesheet" href="https://unpkg.com/@ariane-ui/core/dist/styles/presets/buttons.css" />`;

const codeDropdown = `<ar-dropdown>
    <button slot="trigger">Actions</button>
    <ar-dropdown-item><button>Modifier</button></ar-dropdown-item>
    <ar-dropdown-item><button>Dupliquer</button></ar-dropdown-item>
    <ar-dropdown-item><button>Supprimer</button></ar-dropdown-item>
</ar-dropdown>`;

const codeDialog = `<button data-ar-dialog-open="mon-dialog">Ouvrir la fenêtre</button>
<ar-dialog id="mon-dialog" label="Informations importantes">
    <p>Votre session expirera dans 5 minutes.</p>
</ar-dialog>`;

const codeDatepicker = `<ar-datepicker
    label="Date de naissance"
    format="dd/MM/yyyy"
    lang="fr-FR"
></ar-datepicker>`;
---

<HomeLayout title="Accueil">
    <!-- Hero — le fil entre par la droite, boucle dans le vide à droite du texte,
         puis ressort par la gauche en débordant sous le hero : il se termine dans
         le coin supérieur gauche du bloc « Ariane c'est.. ». Le calque
         `.thread-layer` déborde volontairement de la section (overflow visible)
         pour que le tracé reste d'un seul tenant. -->
    <section class="hero">
        <div class="thread-layer thread-layer--top-wide" aria-hidden="true">
            <svg
                class="thread thread--wide"
                viewBox="0 0 1440 1064"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    class="thread-echo"
                    vector-effect="non-scaling-stroke"
                    d="M1470 113 C1200 157, 1072 235, 1142 356 C1212 492, 1400 511, 1372 643 C1345 772, 1120 834, 880 788 C620 740, 400 838, 230 918 C130 966, 50 1000, -20 1052"
                ></path>
                <path
                    class="thread-main"
                    vector-effect="non-scaling-stroke"
                    d="M1460 149 C1230 190, 1105 244, 1170 345 C1235 471, 1420 494, 1395 626 C1372 747, 1130 795, 900 753 C640 705, 420 800, 250 880 C150 928, 60 960, -20 1010"
                ></path>
                <path
                    class="thread-accent"
                    vector-effect="non-scaling-stroke"
                    d="M1450 186 C1262 221, 1140 246, 1200 335 C1260 452, 1440 480, 1416 611 C1394 726, 1140 767, 918 726 C660 672, 440 764, 270 842 C170 890, 80 920, -20 968"
                ></path>
            </svg>
            <span class="thread-bead thread-bead--wide"></span>
        </div>

        <!-- Mobile : c'est le filet dilué qui longe le titre « Ariane c'est.. »,
             pas l'ambre — un aplat saturé collé au texte se lit moins bien qu'un
             gris à 16 %. L'ordre des trois traits y est donc inversé par rapport
             au desktop, où le fil passe loin de tout texte. Les trois départs
             restent dans la plage y >= 0 avant x = 390 : sinon le tracé du haut
             serait rogné par le bord supérieur du viewBox et n'atteindrait pas
             le bord droit de la section. -->
        <div class="thread-layer thread-layer--top-narrow" aria-hidden="true">
            <svg
                class="thread thread--narrow"
                viewBox="0 0 390 340"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
            >
                <path
                    class="thread-echo"
                    vector-effect="non-scaling-stroke"
                    d="M400 40 C308 40, 312 122, 206 130 C144 135, 118 172, 88 212 C58 250, 20 264, -10 278"
                ></path>
                <path
                    class="thread-main"
                    vector-effect="non-scaling-stroke"
                    d="M400 10 C300 10, 300 96, 200 104 C140 109, 115 145, 85 185 C55 222, 20 236, -10 250"
                ></path>
                <path
                    class="thread-accent"
                    vector-effect="non-scaling-stroke"
                    d="M400 4 C300 4, 288 70, 196 78 C138 83, 116 120, 88 160 C58 200, 22 212, -10 228"
                ></path>
            </svg>
            <span class="thread-bead thread-bead--narrow"></span>
        </div>

        <div class="hero-inner">
            <h1 class="hero-title">Accessible. Personnalisable.<br />Sans compromis.</h1>

            <p class="hero-pitch">
                Des composants web natifs et accessibles au maximum, qui s'intégrent facilement à vos projets
                ou votre design system.
            </p>

            <div class="hero-ctas">
                <a href="/getting-started/quickstart" class="btn-primary">Démarrage rapide</a>
                <a href={firstComponentHref} class="btn-secondary">Voir les composants</a>
            </div>

            <ul class="hero-facts">
                <li><strong>v{version}</strong></li>
                <li>{componentCount} composants</li>
                <li><a href="https://lit.dev" target="_blank" rel="noopener noreferrer"
                >Lit 3</a> - Typescript</li>
            </ul>
        </div>
    </section>

    <!-- La promesse d'Ariane — six points enfilés sur des filets horizontaux :
         le fil du hero se prolonge en lignes de structure. -->
    <section class="promise">
        <h2 class="promise-title">Ariane c'est..</h2>

        <div class="promise-grid">
            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg aria-hidden="true" viewBox="0 0 48 48" fill="none" stroke="currentColor">
                        <!-- Anneau extérieur : cercle unique tracé au rayon moyen (18-22),
                             avec un stroke-width couvrant exactement l'épaisseur d'origine. -->
                        <circle cx="24" cy="24" r="20" stroke-width="4"></circle>
                        <!-- Tête : un disque plein (comme l'original) tracé en stroke —
                             rayon du tracé = rayon cible / 2, épaisseur = rayon cible,
                             le trait remplit alors tout le disque au lieu de le creuser. -->
                        <circle cx="24" cy="13" r="1.5" stroke-width="3"></circle>
                        <!-- Bras + torse + jambes : tracé original inchangé, rempli comme
                             à l'origine (une silhouette pleine n'a pas d'équivalent stroke
                             fidèle — la contourner en creux changerait sa lecture). -->
                        <path
                            fill="currentColor"
                            stroke="none"
                            d="M35,17H13a2,2,0,0,0,0,4h7v4.8l-2,9.8A2.1,2.1,0,0,0,19.6,38H20a2.1,2.1,0,0,0,2-1.6L23.8,27h.4L26,36.4A2.1,2.1,0,0,0,28,38h.4A2.1,2.1,0,0,0,30,35.6l-2-9.8V21h7a2,2,0,0,0,0-4Z"
                        ></path>
                    </svg>
                </span>
                <h3>Une accessiblité maximisée</h3>
                <p>
                    Navigation clavier, rôles ARIA et annonces aux lecteurs d'écran : les composants gèrent un maximum de cas pour vous laisser un minimum de travail.
                </p>
            </article>

            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M12 2s7 7.58 7 12a7 7 0 1 1-14 0c0-4.42 7-12 7-12Z"></path>
                    </svg>
                </span>
                <h3>Votre style avant tout</h3>
                <p>
                    Chaque composant est livré sans habillage visuel par défaut. <a
                        href="getting-started/utilisation#personnalisation">Créez votre thème</a
                    > pour qu'ils s'adaptent à votre projet.
                </p>
            </article>

            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="4" y="11" width="16" height="10" rx="2"></rect>
                        <path d="M8 11V7a4 4 0 0 1 7.5-2"></path>
                    </svg>
                </span>
                <h3>Zéro framework imposé</h3>
                <p>
                    Chaque composant est un custom element natif utilisable avec n'importe quel framework front-end.. ou
                    sans framework du tout.
                </p>
            </article>
            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="6" y="2" width="12" height="20" rx="2"></rect>
                        <path d="M11 18h2"></path>
                    </svg>
                </span>
                <h3>Pensé pour le mobile</h3>
                <p>
                    Chaque composant est pensé pour le mobile et intégre des mécanismes utiles pour
                    s'adapter à tous les usages.
                </p>
            </article>

            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"></path>
                    </svg>
                </span>
                <h3>Pour tous vos projets</h3>
                <p>
                    Chargez l'autoloader d'Ariane en une seule ligne <a
                        href="getting-started/quickstart#cdn">depuis un CDN</a
                    > ou <a href="getting-started/quickstart#cdn">intégrez le à votre workflow</a> et
                    configurez-le selon vos besoins.
                </p>
            </article>

            <article class="promise-item">
                <span class="promise-node" aria-hidden="true">
                    <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M3 12h18"></path>
                        <path d="M12 3c2.5 2.5 3.5 6 3.5 9s-1 6.5-3.5 9c-2.5-2.5-3.5-6-3.5-9s1-6.5 3.5-9Z"
                        ></path>
                    </svg>
                </span>
                <h3>Traduction intégrée</h3>
                <p>
                    Le français et l'anglais sont inclus, mais Ariane peut <a href="getting-started/i18n"
                        >s'adapter facilement et rapidement à n'importe quelle langue</a
                    >.
                </p>
            </article>
        </div>
    </section>

    <!-- Essayez-le — bande sombre, deux étapes reliées par un fil vertical.
         Le fil du bas repart du coin inférieur gauche de cette bande et déborde
         sur « Prêt à commencer ? » : un seul tracé pour deux fonds, dont l'encre
         bascule du clair au sombre via un dégradé calé sur la frontière. -->
    <section class="try">
        <div class="thread-layer thread-layer--bottom" aria-hidden="true">
            <svg
                class="thread thread--bottom"
                viewBox="0 0 1440 380"
                preserveAspectRatio="none"
                aria-hidden="true"
                focusable="false"
            >
                <defs>
                    <linearGradient
                        id="thread-bottom-ink"
                        gradientUnits="userSpaceOnUse"
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="380"
                    >
                        <stop offset="0.395" stop-color="var(--doc-on-dark)"></stop>
                        <stop offset="0.46" stop-color="var(--doc-line)"></stop>
                    </linearGradient>
                    <linearGradient
                        id="thread-bottom-veil"
                        gradientUnits="userSpaceOnUse"
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="380"
                    >
                        <stop offset="0.395" stop-color="var(--doc-on-dark-line)"></stop>
                        <stop offset="0.46" stop-color="var(--doc-line-soft)"></stop>
                    </linearGradient>
                </defs>
                <path
                    class="thread-echo"
                    vector-effect="non-scaling-stroke"
                    d="M-20 24 C196 24, 330 92, 508 142 C686 192, 884 226, 1072 218 C1244 211, 1374 244, 1460 292"
                ></path>
                <path
                    class="thread-main"
                    vector-effect="non-scaling-stroke"
                    d="M-20 52 C190 52, 320 118, 500 168 C680 218, 880 252, 1070 244 C1240 237, 1370 268, 1460 316"
                ></path>
                <path
                    class="thread-accent"
                    vector-effect="non-scaling-stroke"
                    d="M-20 80 C184 80, 312 144, 494 194 C674 244, 876 278, 1068 270 C1236 263, 1366 292, 1460 340"
                ></path>
            </svg>
        </div>

        <div class="try-inner">
            <h2 class="try-title">Testez en quelques secondes</h2>
            <p class="try-pitch">Deux étapes, zéro configuration.</p>

            <ol class="steps">
                <li class="step">
                    <div class="step-header">
                        <span class="step-node" aria-hidden="true">1</span>
                        <p class="step-label">Copiez script et thème dans le <code>&lt;head&gt;</code></p>
                    </div>
                    <div class="code-block">
                        <button class="copy-btn" data-copy aria-label="Copier le code">Copier</button
                        >
                        <pre><code class="language-html" set:text={codeInstall} /></pre>
                    </div>
                </li>

                <li class="step">
                    <div class="step-header">
                        <span class="step-node" aria-hidden="true">2</span>
                        <p class="step-label">Copiez le composant dans le <code>&lt;body&gt;</code></p>
                    </div>

                    <ar-tab-group class="try-tabs" active="dropdown" data-theme="light">
                        <ar-tab class="try-tab" panel="dropdown">
                            <span class="try-tab-badge" aria-hidden="true">
                                <svg
                                    class="try-tab-icon"
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M4 6h16"></path><path d="M4 12h16"></path><path
                                        d="M4 18h10"></path>
                                </svg>
                            </span>
                            <span class="try-tab-label">Dropdown</span>
                        </ar-tab>
                        <ar-tab class="try-tab" panel="dialog">
                            <span class="try-tab-badge" aria-hidden="true">
                                <svg
                                    class="try-tab-icon"
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect x="3" y="4" width="18" height="16" rx="2"></rect><path
                                        d="M3 9h18"></path>
                                </svg>
                            </span>
                            <span class="try-tab-label">Modale</span>
                        </ar-tab>
                        <ar-tab class="try-tab" panel="datepicker">
                            <span class="try-tab-badge" aria-hidden="true">
                                <svg
                                    class="try-tab-icon"
                                    aria-hidden="true"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.75"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect x="3" y="5" width="18" height="16" rx="2"></rect>
                                    <path d="M8 3v4"></path><path d="M16 3v4"></path><path
                                        d="M3 11h18"></path>
                                </svg>
                            </span>
                            <span class="try-tab-label">Calendrier</span>
                        </ar-tab>

                        <ar-tab-panel name="dropdown">
                            <div class="try-grid">
                                <div class="code-block">
                                    <button class="copy-btn" data-copy aria-label="Copier le code"
                                        >Copier</button
                                    >
                                    <pre><code class="language-html" set:text={codeDropdown} /></pre>
                                </div>
                                <div class="try-preview">
                                    <div class="try-browser-bar" aria-hidden="true">
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                    </div>
                                    <div class="try-preview-stage">
                                        <ar-dropdown>
                                            <button slot="trigger" class="ar-btn ar-btn-secondary"
                                                >Actions</button
                                            >
                                            <ar-dropdown-item><button>Modifier</button
                                                ></ar-dropdown-item
                                            >
                                            <ar-dropdown-item><button>Dupliquer</button
                                                ></ar-dropdown-item
                                            >
                                            <ar-dropdown-item><button>Supprimer</button
                                                ></ar-dropdown-item
                                            >
                                        </ar-dropdown>
                                    </div>
                                </div>
                            </div>
                        </ar-tab-panel>

                        <ar-tab-panel name="dialog">
                            <div class="try-grid">
                                <div class="code-block">
                                    <button class="copy-btn" data-copy aria-label="Copier le code"
                                        >Copier</button
                                    >
                                    <pre><code class="language-html" set:text={codeDialog} /></pre>
                                </div>
                                <div class="try-preview">
                                    <div class="try-browser-bar" aria-hidden="true">
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                    </div>
                                    <div class="try-preview-stage">
                                        <button
                                            data-ar-dialog-open="mon-dialog"
                                            class="ar-btn ar-btn-secondary"
                                            >Ouvrir la fenêtre</button
                                        >
                                        <ar-dialog id="mon-dialog" label="Informations importantes">
                                            <p>Votre session expirera dans 5 minutes.</p>
                                        </ar-dialog>
                                    </div>
                                </div>
                            </div>
                        </ar-tab-panel>

                        <ar-tab-panel name="datepicker">
                            <div class="try-grid">
                                <div class="code-block">
                                    <button class="copy-btn" data-copy aria-label="Copier le code"
                                        >Copier</button
                                    >
                                    <pre><code
                                            class="language-html"
                                            set:text={codeDatepicker}
                                        /></pre>
                                </div>
                                <div class="try-preview">
                                    <div class="try-browser-bar" aria-hidden="true">
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                        <span class="try-browser-dot"></span>
                                    </div>
                                    <div class="try-preview-stage">
                                        <ar-datepicker
                                            label="Date de naissance"
                                            format="dd/MM/yyyy"
                                            lang="fr-FR"></ar-datepicker>
                                    </div>
                                </div>
                            </div>
                        </ar-tab-panel>
                    </ar-tab-group>
                </li>
            </ol>
        </div>
    </section>

    <!-- CTA bas de page — le fil ressort une dernière fois et s'arrête net. -->
    <section class="outro">

        <div class="outro-inner">
            <h2>Prêt à commencer ?</h2>
            <p>Installez Ariane en quelques minutes ou explorez le catalogue de composants.</p>
            <div class="outro-actions">
                <a href="/getting-started/quickstart" class="btn-primary">Démarrage rapide</a>
                <a href={firstComponentHref} class="btn-secondary">Explorer les composants</a>
            </div>
        </div>
    </section>

    <footer class="landing-footer">
        <p>Ariane — Licence MIT</p>
        <p>
            Construit avec <a href="https://lit.dev" target="_blank" rel="noopener noreferrer"
                >Lit 3</a
            >
            · <a href="https://github.com/jogo-labs/ariane" target="_blank" rel="noopener noreferrer"
                >GitHub</a
            >
        </p>
    </footer>
</HomeLayout>

<style>
    /* ── Le fil ────────────────────────────────────────────
       Un seul trait porteur, doublé de deux lignes de niveau (une diluée, une
       ambre) qui le suivent sans jamais le concurrencer. Les tracés sont
       étirés avec preserveAspectRatio="none" : `vector-effect` garde une
       épaisseur constante quelle que soit la déformation, et les perles sont
       des éléments HTML positionnés en pourcentage — un <circle> deviendrait
       une ellipse. */
    /* Le calque porte la géométrie (donc le débordement d'une section sur la
       suivante), le SVG le remplit et la perle se place en pourcentage du même
       repère : viewBox et pourcentages restent alignés sans calcul. Les calques
       débordent de leur section, ils ne peuvent donc pas passer en z-index
       négatif (ils disparaîtraient sous le fond opaque de la section suivante) :
       ce sont les contenus traversés qui repassent devant, en position:relative. */
    .thread-layer {
        position: absolute;
        pointer-events: none;
    }

    .thread {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        fill: none;
        stroke-linecap: round;
    }

    .thread-layer--top-wide {
        display: none;
        top: 0;
        left: 0;
        right: 0;
        bottom: -175px;
    }

    .thread-layer--top-narrow {
        left: 0;
        right: 0;
        bottom: -150px;
        height: 340px;
    }

    /* Le débordement sur « Prêt à commencer ? » vaut toujours 57,8 % de la
       hauteur du calque : la frontière des deux fonds tombe donc au même endroit
       du viewBox quelle que soit la taille, et les arrêts de dégradé restent
       calés dessus. */
    .thread-layer--bottom {
        --thread-bottom-height: 240px;

        left: 0;
        right: 0;
        height: var(--thread-bottom-height);
        bottom: calc(var(--thread-bottom-height) * -0.578);
    }

    .thread-main {
        stroke: var(--doc-line);
        stroke-width: 1.5;
    }

    .thread-echo {
        stroke: var(--doc-line-soft);
        stroke-width: 1;
    }

    .thread-accent {
        stroke: var(--doc-accent);
        stroke-width: 1.25;
    }

    /* Le fil du bas traverse le vert-noir puis le gris clair : l'encre pleine et
       le filet dilué basculent au passage, seul l'ambre reste lisible sur les
       deux fonds sans changer. */
    .thread--bottom .thread-main {
        stroke: url(#thread-bottom-ink);
    }

    .thread--bottom .thread-echo {
        stroke: url(#thread-bottom-veil);
    }

    /* Le halo de la couleur du fond découpe le trait autour de la perle : elle se
       lit comme un nœud sur le fil, pas comme une pastille posée dessus. */
    .thread-bead {
        position: absolute;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        background: var(--doc-accent);
        box-shadow: 0 0 0 5px var(--doc-stone);
        pointer-events: none;
    }

    /* Perle posée exactement sur le point (1170, 345) du tracé porteur, exprimé
       en pourcentage du viewBox (1440 × 1064). */
    .thread-bead--wide {
        left: 81.25%;
        top: 32.4%;
        transform: translate(-50%, -50%);
    }

    /* Point (200, 104) du viewBox 390 × 340. */
    .thread-bead--narrow {
