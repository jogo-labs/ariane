{
  "buildCommand": "npx turbo run build --filter=@ariane-ui/docs...",
  "outputDirectory": "apps/docs/dist",
  "installCommand": "npm install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "next.ariane-ui.com"
          }
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
